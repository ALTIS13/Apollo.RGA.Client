@@ -0,0 +1,223 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/internal/tunnelcore"
+	"github.com/xtaci/smux"
+)
+
+// Compile RED is intentional until the additive API exists. An empty adapter
+// still fails the stage assertions: these exercise the real CONNECT parser,
+// dispatch, TCP dial and smux ACK, rather than calling observeConnect directly.
+// ai-generated: actual CONNECT stages catch a missing observation boundary.
+func TestConnectObservationActualStages(t *testing.T) {
+	constants := []ConnectObservation{ConnectEntry, ConnectLeaseDenied, ConnectDialBegin, ConnectDialFailed, ConnectAborted, ConnectAckFailed, ConnectAckOK}
+	if !reflect.DeepEqual(constants, []ConnectObservation{"ENTRY", "LEASE_DENIED", "DIAL_BEGIN", "DIAL_FAILED", "ABORTED", "ACK_FAILED", "ACK_OK"}) {
+		t.Fatal("CONNECT_OBSERVATION_FIXED_VOCABULARY_CHANGED")
+	}
+	for _, tc := range []struct {
+		mode string
+		want []ConnectObservation
+	}{
+		{"echo", []ConnectObservation{ConnectEntry, ConnectDialBegin, ConnectAckOK, ConnectObservation("UPSTREAM_DATA")}},
+		{"lease-denied", []ConnectObservation{ConnectEntry, ConnectLeaseDenied}},
+		{"dial-failed", []ConnectObservation{ConnectEntry, ConnectDialBegin, ConnectDialFailed}},
+		{"aborted", []ConnectObservation{ConnectEntry, ConnectDialBegin, ConnectAborted}},
+		{"ack-failed", []ConnectObservation{ConnectEntry, ConnectDialBegin, ConnectAckFailed}},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			var mu sync.Mutex
+			var stages []ConnectObservation
+			sink := func(stage ConnectObservation) { mu.Lock(); stages = append(stages, stage); mu.Unlock() }
+			observedConnectFlow(t, tc.mode, sink)
+			mu.Lock()
+			defer mu.Unlock()
+			if !reflect.DeepEqual(stages, tc.want) {
+				t.Fatalf("CONNECT_OBSERVATION_ACTUAL_STAGES_MISSING: got=%v want=%v", stages, tc.want)
+			}
+		})
+	}
+}
+
+// ai-generated: forwarding must survive absent or failed diagnostics.
+func TestConnectObservationNilAndPanicDoNotChangeRealFlow(t *testing.T) {
+	t.Run("nil", func(t *testing.T) { observedConnectFlow(t, "echo", nil) })
+	t.Run("panic", func(t *testing.T) {
+		var calls atomic.Int32
+		observedConnectFlow(t, "echo", func(ConnectObservation) {
+			calls.Add(1)
+			panic("private observer failure must not escape")
+		})
+		if calls.Load() != 4 {
+			t.Fatalf("CONNECT_OBSERVATION_PANIC_SINK_NOT_EXERCISED: calls=%d", calls.Load())
+		}
+	})
+}
+
+// ai-generated: record first actual bytes once, and never mark data observed after cancellation.
+func TestUpstreamReadWitnessPreservesBytesAndCancellation(t *testing.T) {
+	for _, cancelled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "live", true: "cancelled"}[cancelled], func(t *testing.T) {
+			left, right := net.Pipe()
+			defer left.Close()
+			defer right.Close()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			var calls atomic.Int32
+			s := &Server{onConnectObservation: func(stage ConnectObservation) {
+				if stage != ConnectUpstreamData {
+					t.Error("unexpected stage")
+				}
+				calls.Add(1)
+			}}
+			conn := &connectReadConn{Conn: left, ctx: ctx, server: s}
+			if cancelled {
+				cancel()
+			}
+			done := make(chan error, 1)
+			go func() { _, err := right.Write([]byte("ok")); done <- err }()
+			_ = left.SetDeadline(time.Now().Add(time.Second))
+			for _, want := range []byte("ok") {
+				var b [1]byte
+				if n, err := conn.Read(b[:]); n != 1 || err != nil || b[0] != want {
+					t.Fatalf("upstream read result changed: n=%d err=%v", n, err)
+				}
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			want := int32(1)
+			if cancelled {
+				want = 0
+			}
+			if calls.Load() != want {
+				t.Fatalf("witness calls=%d want=%d", calls.Load(), want)
+			}
+		})
+	}
+}
+
+// Only the protected target-dial seam is redirected to a real local TCP echo
+// endpoint. The observer receives no destination, session ID, payload or error.
+// ai-generated: real smux parser, protected dial seam and TCP echo fixture.
+func observedConnectFlow(t *testing.T, mode string, sink func(ConnectObservation)) {
+	t.Helper()
+	_ = Config{OnConnectObservation: sink}
+	serverSession, clientSession, closePair := smuxPair(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		closePair()
+		cancel()
+		t.Fatal(err)
+	}
+	endpointDone := make(chan struct{})
+	go func() {
+		defer close(endpointDone)
+		conn, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		request := make([]byte, 4)
+		if _, readErr := io.ReadFull(conn, request); readErr == nil && string(request) == "ping" {
+			_, _ = conn.Write([]byte("pong"))
+		}
+	}()
+	handlerDone := make(chan struct{})
+	started := false
+	t.Cleanup(func() {
+		cancel()
+		closePair()
+		_ = listener.Close()
+		if started {
+			select {
+			case <-handlerDone:
+			case <-time.After(3 * time.Second):
+				t.Error("CONNECT observation handler unjoined")
+			}
+		}
+		select {
+		case <-endpointDone:
+		case <-time.After(3 * time.Second):
+			t.Error("CONNECT observation endpoint unjoined")
+		}
+	})
+	s := newHandshakeServer()
+	s.meter = newMeter()
+	s.onConnectObservation = sink
+	s.requireMeter = mode == "lease-denied"
+	var accepted *smux.Stream
+	s.dialTarget = func(ctx context.Context, _, _ string) (net.Conn, error) {
+		if mode == "dial-failed" {
+			return nil, errors.New("private dial detail must not become an observation")
+		}
+		conn, dialErr := (&net.Dialer{}).DialContext(ctx, "tcp4", listener.Addr().String())
+		if dialErr == nil {
+			if mode == "aborted" {
+				cancel()
+			}
+			if mode == "ack-failed" {
+				_ = accepted.Close()
+			}
+		}
+		return conn, dialErr
+	}
+	stream, err := clientSession.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Close()
+	accepted, err = serverSession.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	started = true
+	go func() {
+		defer close(handlerDone)
+		s.handleStreamWithLease(ctx, accepted, "private-session-not-in-observation", nil)
+	}()
+	_ = stream.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := stream.Write([]byte(`{"cmd":"connect","addr":"8.8.8.8","port":443}`)); err != nil {
+		t.Fatal(err)
+	}
+	var ack [1]byte
+	_, err = io.ReadFull(stream, ack[:])
+	switch mode {
+	case "echo":
+		if err != nil || ack[0] != tunnelcore.ConnectAckOK {
+			t.Fatalf("CONNECT success changed: err=%v", err)
+		}
+		if _, err := stream.Write([]byte("ping")); err != nil {
+			t.Fatal(err)
+		}
+		response := make([]byte, 4)
+		if _, err := io.ReadFull(stream, response); err != nil || string(response) != "pong" {
+			t.Fatalf("CONNECT observation changed real ping/pong: err=%v", err)
+		}
+	case "dial-failed":
+		if err != nil || ack[0] != tunnelcore.ConnectAckHostUnreachable {
+			t.Fatalf("dial refusal changed: err=%v", err)
+		}
+	default:
+		if err == nil {
+			t.Fatal("denied/aborted/failed ACK became success")
+		}
+	}
+	_ = stream.Close()
+	select {
+	case <-handlerDone:
+	case <-time.After(3 * time.Second):
+		t.Fatal("CONNECT observation dispatch did not finish")
+	}
+}
