+func TestMandatoryDNSNameUsesStreamDespiteDirectOverlap(t *testing.T) {
+	ring, err := fakedns.Start(map[string]string{"vk.cc": "10.0.0.1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ring.Close() })
+	query := aQueryFor(t, "vk.cc.")
+	streamed := make(chan []byte, 1)
+	c, srv := newDNSTestClient(t, func(stream *smux.Stream) error {
+		q, readErr := readFramedQuery(stream)
+		if readErr == nil {
+			streamed <- q
+		}
+		return readErr
+	})
+	c.rules = mustRules(t, "domain:vk.cc\ntunnel-domain:cc\n")
+	c.exchanger = protect.NewResolver(ring.Addr)
+	assoc, cli := dnsTestSockets(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c.forwardLocalUDP(ctx, &dnsTestLane{}, assoc, cli.LocalAddr().(*net.UDPAddr),
+		socksDatagram(t, dnsTestResolver, dnsPort, query))
+	select {
+	case got := <-streamed:
+		if !bytes.Equal(got, query) {
+			t.Fatal("denied DNS question changed on stream path")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("denied DNS name never used stream")
+	}
+	if ring.Queries() != 0 {
+		t.Fatal("denied DNS name leaked to direct resolver ring")
+	}
+	noErrors(t, srv.errs)
+	cancel()
+	waitTracked(t, c)
+}
