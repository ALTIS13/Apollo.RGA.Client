+func awaitLoadStage(t *testing.T, h loaddiag.Handle, stage string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if strings.Contains(h.Snapshot(), stage) {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("real blocked boundary not observed: %s; snapshot=%s", stage, h.Snapshot())
+}
+
+func TestLoadDiagnosticsTrackBlockedBoundaries(t *testing.T) {
+	for _, kind := range []string{"TRACK_MUTEX", "TRACK_WRITE"} {
+		t.Run(kind, func(t *testing.T) {
+			h := loaddiag.New()
+			defer h.Retire()
+			entered, release := make(chan struct{}), make(chan struct{})
+			done := make(chan struct{})
+			p := &streamTransport{loadDiagnostics: h, sampleWriter: func([]byte) bool { close(entered); <-release; return true }}
+			if kind == "TRACK_MUTEX" {
+				p.writeMu.Lock()
+			}
+			defer func() {
+				if kind == "TRACK_MUTEX" {
+					p.writeMu.Unlock()
+				}
+				close(release)
+				<-done
+			}()
+			go func() { p.writeSampleLocked([]byte("sample")); close(done) }()
+			if kind == "TRACK_WRITE" {
+				<-entered
+			}
+			awaitLoadStage(t, h, "stage="+kind+" class=OTHER lane=SHARED active=1")
+		})
+	}
