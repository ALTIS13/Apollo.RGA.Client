+func TestManagedUDPClientUnknownWelcomeBlocksForeign(t *testing.T) {
+	for _, kind := range []string{"missing", "unknown", "malformed", "valid"} {
+		t.Run(kind, func(t *testing.T) {
+			serverSess, clientSess := newSmuxPair(t)
+			done := make(chan error, 1)
+			go func() {
+				s, err := serverSess.AcceptStream()
+				if err != nil {
+					done <- err
+					return
+				}
+				var n [4]byte
+				if _, err = io.ReadFull(s, n[:]); err != nil {
+					done <- err
+					return
+				}
+				raw := make([]byte, binary.BigEndian.Uint32(n[:]))
+				if _, err = io.ReadFull(s, raw); err != nil {
+					done <- err
+					return
+				}
+				var hello handshake.Hello
+				if err = json.Unmarshal(raw, &hello); err != nil {
+					done <- err
+					return
+				}
+				w := handshake.Welcome{Version: 3, Type: handshake.TypeWelcome, SessionID: "managed-session", Challenge: hello.Challenge}
+				if kind != "missing" {
+					w.UDPContract = 2
+					w.UDPGeneration = base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{1}, 32))
+				}
+				if kind == "unknown" {
+					w.UDPContract = 9
+				}
+				if kind == "malformed" {
+					w.UDPGeneration = "bad"
+				}
+				raw, err = json.Marshal(w)
+				if err == nil {
+					binary.BigEndian.PutUint32(n[:], uint32(len(raw)))
+					_, err = s.Write(append(n[:], raw...))
+				}
+				done <- err
+			}()
+			s, w, err := openManagedControlStreamTimeout(context.Background(), clientSess, "device", nil, handshake.ClientOptions{UDPContract: 2}, time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer s.Close()
+			if err = <-done; err != nil {
+				t.Fatal(err)
+			}
+			if w.SessionID != "managed-session" || clientSess.IsClosed() {
+				t.Fatal("TCP control was lost")
+			}
+			c, l, server, a, b := managedClientFixture(t)
+			installClientWelcome(c, w)
+			managedClientSend(t, c, l, a, b, []byte("ping"))
+			got := l.packets()
+			if kind != "valid" {
+				if len(got) != 0 {
+					t.Fatalf("foreign enqueues without admitted binding=%d", len(got))
+				}
+				return
+			}
+			if len(got) != 1 {
+				t.Fatalf("current managed enqueues=%d", len(got))
+			}
+			wire, err := server.OpenInto(nil, got[0], []byte(udpwire.ManagedAAD))
+			if err != nil {
+				t.Fatalf("valid binding did not use managed AAD: %v", err)
+			}
+			frame, err := udpwire.DecodeManaged(wire)
+			if err != nil || frame.Frame.FlowID != 1 || string(frame.Frame.Payload) != "ping" {
+				t.Fatalf("current frame=%+v, %v", frame, err)
+			}
+		})
+	}
+	t.Run("unknown selector cannot downgrade", func(t *testing.T) {
+		c, l, _, a, b := managedClientFixture(t)
+		c.udpContract = 7
+		managedClientSend(t, c, l, a, b, []byte("ping"))
+		if len(l.packets()) != 0 {
+			t.Fatal("unknown selector emitted legacy traffic")
+		}
+	})
+	t.Run("disabled", func(t *testing.T) {
+		c, l, _, a, b := managedClientFixture(t)
+		c.udpDisabled = true
+		installClientWelcome(c, managedWelcome(1))
+		managedClientSend(t, c, l, a, b, []byte("ping"))
+		if len(l.packets()) != 0 {
+			t.Fatal("disabled managed UDP emitted")
+		}
+	})
+}
