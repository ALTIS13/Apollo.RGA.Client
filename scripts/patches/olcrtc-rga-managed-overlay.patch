+	for _, host := range []string{"127.0.0.1", "10.1.2.3", "100.64.1.2"} {
+		if got, _ := c.classifyConnect(host); got != routeDirect {
+			t.Fatalf("private/local %s = %v, want immediate direct", host, got)
+		}
+	}
+	conn := socksConnect(t, c, directTestLoopback, port)
+	if rep := readReply(t, conn); rep != socksRepSuccess {
+		t.Fatalf("local reply = %#x", rep)
+	}
+	expectEcho(t, conn)
+	noErrors(t, errs)
+}
+
+func TestMandatorySniffedRussianNameStaysDeviceDirect(t *testing.T) {
+	hello := clientHello(t, "a.ru")
+	port, errs := echoServer(t, hello)
+	c := newDirectTestClient(t, mustRules(t, "tunnel-domain:cc\ntunnel-domain:at\ndomain:ru\n203.0.113.0/24\n"),
