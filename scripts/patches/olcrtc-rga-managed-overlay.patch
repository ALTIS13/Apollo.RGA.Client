+// ai-generated: fake only the upstream protocol; read EOF exposes the adapter's actual control closure.
+func (f *managedSOCKSFixture) serve(opts managedSOCKSOptions) {
+	defer close(f.done)
+	conn, err := f.listener.AcceptTCP()
+	if err != nil {
+		return
+	}
+	f.control.Store(conn)
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(12 * time.Second))
+	if err = f.negotiate(conn, opts); err != nil {
+		f.err <- err
+		return
+	}
+	if opts.hold != "" {
+		_, _ = io.Copy(io.Discard, conn)
+		return
+	}
+	time.Sleep(opts.replyDelay)
+	reply := opts.reply
+	if reply == nil {
+		port := f.relay.LocalAddr().(*net.UDPAddr).Port
+		reply = []byte{5, 0, 0, 1, 127, 0, 0, 1, byte(port >> 8), byte(port)}
+		if opts.ipv6 {
+			reply = append([]byte{5, 0, 0, 4}, net.ParseIP("::1").To16()...)
+			reply = append(reply, byte(port>>8), byte(port))
+		}
+	}
+	if _, err = conn.Write(reply); err != nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, conn)
+}
