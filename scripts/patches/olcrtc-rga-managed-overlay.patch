+)
+
+func awaitLoadStage(t *testing.T, h loaddiag.Handle, stage string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if strings.Contains(h.Snapshot(), stage) {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("real blocked boundary not observed: %s; snapshot=%s", stage, h.Snapshot())
+}
+
+func TestLoadDiagnosticsMuxBlockedBoundaries(t *testing.T) {
+	for _, kind := range []string{"AWAIT_LINK", "MUX_SEND", "MUX_TAKE"} {
+		t.Run(kind, func(t *testing.T) {
+			keys, _ := newTestKeyPair(t)
+			link := &stubLink{canSend: kind != "AWAIT_LINK"}
+			h := loaddiag.New()
+			defer h.Retire()
+			c := New(link, keys, loaddiag.WithOwner(context.Background(), h))
+			defer c.Close()
+			entered, release := make(chan struct{}), make(chan struct{})
+			done := make(chan struct{})
+			defer func() { close(release); _ = c.Close(); <-done }()
+			if kind == "MUX_SEND" {
+				c.send = func([]byte) error { close(entered); <-release; return nil }
+			}
+			if kind == "MUX_TAKE" {
+				c.in = make(chan *[]byte)
+			}
+			go func() {
+				defer close(done)
+				if kind == "MUX_TAKE" {
+					b := acquireFrameBuf()
+					c.take(b)
+				} else {
+					_, _ = c.Write([]byte("record"))
+				}
+			}()
+			if kind == "MUX_SEND" {
+				<-entered
+			}
+			awaitLoadStage(t, h, "stage="+kind+" class=OTHER lane=DATA active=1")
+		})
+	}
+}
+
+func TestLoadDiagnosticsControlConstructorOwner(t *testing.T) {
+	keys, _ := newTestKeyPair(t)
+	h := loaddiag.New()
+	defer h.Retire()
+	c := NewControl(&loopLink{peer: &loopLink{}}, keys, loaddiag.WithOwner(context.Background(), h))
+	defer c.Close()
+	c.in = make(chan *[]byte)
+	done := make(chan struct{})
+	defer func() { _ = c.Close(); <-done }()
+	go func() { c.take(acquireFrameBuf()); close(done) }()
+	awaitLoadStage(t, h, "stage=MUX_TAKE class=OTHER lane=CONTROL active=1")
+}
