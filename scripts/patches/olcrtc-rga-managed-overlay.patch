+++ b/internal/loaddiag/diagnostics.go
@@ -0,0 +1,298 @@
+// Package loaddiag provides optional owner-local, finite transport boundary observations.
+// ai-generated: bounded diagnostic accumulator; no logger, timer or background worker.
+package loaddiag
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+type Stage uint8
+type Class uint8
+type Lane uint8
+type Outcome uint8
+type Counter uint8
+type Gauge uint8
+
+const (
+	ConnectOpen Stage = iota
+	ConnectWrite
+	ConnectAck
+	HeadWrite
+	AwaitLink
+	MuxSend
+	MuxTake
+	KCPEnqueue
+	TrackMutex
+	TrackWrite
+	stageCount
+)
+const (
+	NumericTCP Class = iota
+	NamedTCP
+	Other
+	classCount
+)
+const (
+	Data Lane = iota
+	Control
+	Shared
+	laneCount
+)
+const (
+	OK Outcome = iota
+	Failed
+)
+const (
+	WriterTick Counter = iota
+	FlushTick
+	SkipControl
+	SkipUDP
+	ACKFallback
+	counterCount
+)
+const (
+	QueueData Gauge = iota
+	QueueACK
+	QueueUDP
+	QueueControl
+	gaugeCount
+)
+
+const (
+	metricCount = int(stageCount) * int(classCount) * int(laneCount)
+	slotCount   = 64
+	maxMillis   = int64(24 * time.Hour / time.Millisecond)
+)
+
+type observation struct {
+	last   atomic.Int64
+	max    atomic.Int64
+	ok     atomic.Uint64
+	failed atomic.Uint64
+}
+type slot struct {
+	start atomic.Int64
+	key   atomic.Uint32
+}
+type collector struct {
+	alive     atomic.Bool
+	clock     func() int64
+	slots     [slotCount]slot
+	metrics   [metricCount]observation
+	counters  [counterCount]atomic.Uint64
+	gauges    [gaugeCount]atomic.Int64
+	saturated atomic.Uint64
+	ackAt     atomic.Int64
+}
+
+// Handle carries opaque ownership. The zero value is disabled and allocation-free.
+type Handle struct{ c *collector }
+
+// Token pairs one boundary entry/exit; it contains no address or flow identity.
+type Token struct {
+	c     *collector
+	index int
+	start int64
+	key   int
+}
+
+type ownerKey struct{}
+
+// New enables one independent owner. Mobile Runtime decides whether to create it.
+func New() Handle {
+	base := time.Now()
+	return newWithClock(func() int64 { return int64(time.Since(base)) + 1 })
+}
+
+func newWithClock(clock func() int64) Handle {
+	c := &collector{clock: clock}
+	c.alive.Store(true)
+	return Handle{c: c}
+}
+
+// WithOwner transports an opaque handle on the already-existing lifecycle context.
+func WithOwner(ctx context.Context, h Handle) context.Context {
+	return context.WithValue(ctx, ownerKey{}, h)
+}
+
+// FromContext is silent for contexts without explicit instrumentation ownership.
+func FromContext(ctx context.Context) Handle {
+	h, _ := ctx.Value(ownerKey{}).(Handle)
+	return h
+}
+
+// Enabled does not read the clock or allocate on the disabled hot path.
+func (h Handle) Enabled() bool { return h.c != nil && h.c.alive.Load() }
+
+// Retire makes all retained/late handles inert without waiting for blocked transport work.
+func (h Handle) Retire() {
+	if h.c != nil {
+		h.c.alive.Store(false)
+	}
+}
+
+// Begin uses a fixed slot pool. Saturation is reported, never expanded or waited on.
+func (h Handle) Begin(stage Stage, class Class, lane Lane) Token {
+	if !h.Enabled() || stage >= stageCount || class >= classCount || lane >= laneCount {
+		return Token{}
+	}
+	key := (int(stage)*int(classCount)+int(class))*int(laneCount) + int(lane)
+	for i := range h.c.slots {
+		s := &h.c.slots[i]
+		if !s.start.CompareAndSwap(0, -1) {
+			continue
+		}
+		now := max(h.c.clock(), 1)
+		s.key.Store(uint32(key))
+		s.start.Store(now)
+		return Token{c: h.c, index: i, start: now, key: key}
+	}
+	h.c.saturated.Add(1)
+	return Token{}
+}
+
+// End observes only a finite success/refusal outcome; error strings are never retained.
+func (t Token) End(outcome Outcome) {
+	if t.c == nil || !t.c.alive.Load() {
+		return
+	}
+	s := &t.c.slots[t.index]
+	if !s.start.CompareAndSwap(t.start, -1) {
+		return
+	}
+	ms := durationMillis(t.c.clock() - t.start)
+	m := &t.c.metrics[t.key]
+	m.last.Store(ms)
+	for previous := m.max.Load(); ms > previous && !m.max.CompareAndSwap(previous, ms); previous = m.max.Load() {
+	}
+	if outcome == OK {
+		m.ok.Add(1)
+	} else {
+		m.failed.Add(1)
+	}
+	s.start.Store(0)
+}
+
+// Count increments one finite event. No caller-supplied data enters the snapshot.
+func (h Handle) Count(counter Counter) {
+	if h.Enabled() && counter < counterCount {
+		h.c.counters[counter].Add(1)
+	}
+}
+
+// Observe retains only a bounded last-observed depth, not a queue-tail guarantee.
+func (h Handle) Observe(gauge Gauge, value int) {
+	if h.Enabled() && gauge < gaugeCount {
+		h.c.gauges[gauge].Store(int64(max(0, min(value, 1<<20))))
+	}
+}
+
+// AckSeen observes an inbound acknowledgement on this owner's monotonic clock.
+func (h Handle) AckSeen() {
+	if h.Enabled() {
+		h.c.ackAt.Store(max(h.c.clock(), 1))
+	}
+}
+
+// AckUnseen distinguishes an unobserved acknowledgement from a fake zero age.
+func (h Handle) AckUnseen() {
+	if h.Enabled() {
+		h.c.ackAt.Store(0)
+	}
+}
+
+func durationMillis(ns int64) int64 { return min(maxMillis, max(0, ns/int64(time.Millisecond))) }
+
+// Snapshot formats fixed enums/numeric fields outside all traffic locks. It calls no sink.
+func (h Handle) Snapshot() string {
+	if !h.Enabled() {
+		return ""
+	}
+	now := h.c.clock()
+	var active, ages [metricCount]int64
+	for i := range h.c.slots {
+		s := &h.c.slots[i]
+		start, key := s.start.Load(), int(s.key.Load())
+		if start > 0 && key < metricCount {
+			active[key]++
+			ages[key] = max(ages[key], durationMillis(now-start))
+		}
+	}
+	var b strings.Builder
+	ack, ackAge := "UNSEEN", int64(0)
+	if at := h.c.ackAt.Load(); at > 0 {
+		ack, ackAge = "SEEN", durationMillis(now-at)
+	}
+	fmt.Fprintf(&b, "RGA_LOAD_V1 stage=SUMMARY saturated=%d ticks=%d flush=%d skip_control=%d skip_udp=%d ack_fallback=%d data_depth=%d ack_depth=%d udp_depth=%d control_depth=%d ack=%s ack_age_ms=%d",
+		h.c.saturated.Load(), h.c.counters[WriterTick].Load(), h.c.counters[FlushTick].Load(),
+		h.c.counters[SkipControl].Load(), h.c.counters[SkipUDP].Load(), h.c.counters[ACKFallback].Load(),
+		h.c.gauges[QueueData].Load(), h.c.gauges[QueueACK].Load(), h.c.gauges[QueueUDP].Load(),
+		h.c.gauges[QueueControl].Load(), ack, ackAge)
+	for key := range h.c.metrics {
+		m := &h.c.metrics[key]
+		ok, failed := m.ok.Load(), m.failed.Load()
+		if active[key] == 0 && ok == 0 && failed == 0 {
+			continue
+		}
+		stage := Stage(key / (int(classCount) * int(laneCount)))
+		class := Class((key / int(laneCount)) % int(classCount))
+		lane := Lane(key % int(laneCount))
+		fmt.Fprintf(&b, "\nRGA_LOAD_V1 stage=%s class=%s lane=%s active=%d age_ms=%d last_ms=%d max_ms=%d ok=%d failed=%d",
+			stageName(stage), className(class), laneName(lane), active[key], ages[key], m.last.Load(), m.max.Load(), ok, failed)
+	}
+	if !h.Enabled() {
+		return ""
+	}
+	return b.String()
+}
+
+func stageName(stage Stage) string {
+	switch stage {
+	case ConnectOpen:
+		return "CONNECT_OPEN"
+	case ConnectWrite:
+		return "CONNECT_WRITE"
+	case ConnectAck:
+		return "CONNECT_ACK"
+	case HeadWrite:
+		return "HEAD_WRITE"
+	case AwaitLink:
+		return "AWAIT_LINK"
+	case MuxSend:
+		return "MUX_SEND"
+	case MuxTake:
+		return "MUX_TAKE"
+	case KCPEnqueue:
+		return "KCP_ENQUEUE"
+	case TrackMutex:
+		return "TRACK_MUTEX"
+	case TrackWrite:
+		return "TRACK_WRITE"
+	default:
+		return "SUMMARY"
+	}
+}
+func className(class Class) string {
+	switch class {
+	case NumericTCP:
+		return "NUMERIC_TCP"
+	case NamedTCP:
+		return "NAMED_TCP"
+	default:
+		return "OTHER"
+	}
+}
+func laneName(lane Lane) string {
+	switch lane {
+	case Data:
+		return "DATA"
+	case Control:
+		return "CONTROL"
+	default:
+		return "SHARED"
+	}
+}
