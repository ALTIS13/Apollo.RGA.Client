new file mode 100644
index 0000000000000000000000000000000000000000..45f260da5bc9a1f785f5d266945402dd07a21459
--- /dev/null
+++ b/internal/server/connect_observation.go
@@ -0,0 +1,58 @@
+package server
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+)
+
+// ConnectObservation is a destination-free CONNECT stage, not an access grant.
+// ai-generated: bounded diagnostic vocabulary.
+type ConnectObservation string
+
+const (
+	ConnectEntry        ConnectObservation = "ENTRY"
+	ConnectLeaseDenied  ConnectObservation = "LEASE_DENIED"
+	ConnectDialBegin    ConnectObservation = "DIAL_BEGIN"
+	ConnectDialFailed   ConnectObservation = "DIAL_FAILED"
+	ConnectAborted      ConnectObservation = "ABORTED"
+	ConnectAckFailed    ConnectObservation = "ACK_FAILED"
+	ConnectAckOK        ConnectObservation = "ACK_OK"
+	ConnectUpstreamData ConnectObservation = "UPSTREAM_DATA"
+)
+
+// observeConnect isolates a trusted nonblocking diagnostic callback from traffic.
+// ai-generated: optional panic-contained observation, without user data.
+func (s *Server) observeConnect(stage ConnectObservation) {
+	if s.onConnectObservation == nil {
+		return
+	}
+	defer func() { _ = recover() }()
+	s.onConnectObservation(stage)
+}
+
+// ai-generated: first upstream data before cancellation, before quota/write settlement.
+// The witness does not retain any payload and preserves Conn's read result.
+type connectReadConn struct {
+	net.Conn
+	ctx    context.Context
+	server *Server
+	seen   atomic.Bool
+}
+
+// ai-generated: bounded observation before the bytes can block in smux.Write.
+func (c *connectReadConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	if n > 0 && c.ctx.Err() == nil && c.seen.CompareAndSwap(false, true) {
+		c.server.observeConnect(ConnectUpstreamData)
+	}
+	return n, err
+}
+
+// ai-generated: retain TCP half-close behavior; match copy's fallback for other Conns.
+func (c *connectReadConn) CloseWrite() error {
+	if writer, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return writer.CloseWrite()
+	}
+	return c.Conn.Close()
+}
