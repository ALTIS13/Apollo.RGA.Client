+	noErrors(t, errs)
+}
+
+func TestMandatoryOpaquePublicPrefixRetainsDirectFallback(t *testing.T) {
+	dialed := make(chan struct{}, 1)
+	protect.SetProtector(func(int) bool { dialed <- struct{}{}; return false })
+	t.Cleanup(func() { protect.SetProtector(nil) })
+	c, _ := newStreamTestClient(t, mustRules(t, "tunnel-domain:cc\n203.0.113.0/24\n"), 0,
+		func(stream *smux.Stream) { _, _ = io.Copy(stream, stream) })
+	conn := socksConnect(t, c, "203.0.113.8", 443)
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	if rep := readReply(t, conn); rep != socksRepSuccess {
+		t.Fatalf("reply = %#x, expected sniff before prefix fallback", rep)
+	}
+	if _, err := conn.Write([]byte("opaque")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-dialed:
+	case <-time.After(time.Second):
+		t.Fatal("opaque matched-prefix target lost its existing direct fallback")
+	}
+}
