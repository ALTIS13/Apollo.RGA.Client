+// ai-generated: check hand-written greeting/credentials/CMD3 bytes without using production parsing helpers.
+func (f *managedSOCKSFixture) negotiate(conn net.Conn, opts managedSOCKSOptions) error {
+	var greeting [3]byte
+	if _, err := io.ReadFull(conn, greeting[:]); err != nil {
+		return err
+	}
+	method := byte(0)
+	if opts.user != "" {
+		method = 2
+	}
+	if greeting != [3]byte{5, 1, method} {
+		return errors.New("unexpected SOCKS greeting")
+	}
+	if opts.hold == "auth" {
+		close(f.stage)
+		return nil
+	}
+	time.Sleep(opts.authDelay)
+	response := opts.methodReply
+	if response == nil {
+		response = []byte{5, method}
+	}
+	if _, err := conn.Write(response); err != nil {
+		return err
+	}
+	if method == 2 && bytes.Equal(response, []byte{5, 2}) {
+		want := append([]byte{1, byte(len(opts.user))}, opts.user...)
+		want = append(want, byte(len(opts.pass)))
+		want = append(want, opts.pass...)
+		got := make([]byte, len(want))
+		if _, err := io.ReadFull(conn, got); err != nil {
+			return err
+		}
+		if !bytes.Equal(got, want) {
+			return errors.New("unexpected SOCKS credentials")
+		}
+		if opts.hold == "credentials" {
+			close(f.stage)
+			return nil
+		}
+		response = opts.credentialReply
+		if response == nil {
+			response = []byte{1, 0}
+		}
+		if _, err := conn.Write(response); err != nil {
+			return err
+		}
+	}
+	var request [10]byte
+	if _, err := io.ReadFull(conn, request[:]); err != nil {
+		return err
+	}
+	if request != [10]byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0} {
+		return errors.New("unexpected UDP ASSOCIATE request")
+	}
+	if opts.hold == "reply" {
+		_, _ = conn.Write([]byte{5, 0, 0, 1})
+		close(f.stage)
+	}
+	return nil
+}
