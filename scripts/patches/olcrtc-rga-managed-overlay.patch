+	"github.com/openlibrecommunity/olcrtc/internal/loaddiag"
+)
+
+func awaitLoadStage(t *testing.T, h loaddiag.Handle, fields string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if strings.Contains(h.Snapshot(), fields) {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("real blocked boundary not observed: %s; snapshot=%s", fields, h.Snapshot())
+}
+
+func TestLoadDiagnosticsConnectAckOutstanding(t *testing.T) {
+	for _, target := range []struct{ host, class string }{{"192.0.2.1", "NUMERIC_TCP"}, {"example.invalid", "NAMED_TCP"}} {
+		t.Run(target.class, func(t *testing.T) {
+			a, b := net.Pipe()
+			server, err := smux.Server(a, testSmuxCfg())
+			if err != nil {
+				t.Fatal(err)
+			}
+			client, err := smux.Client(b, testSmuxCfg())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			defer client.Close()
+			h := loaddiag.New()
+			defer h.Retire()
+			requestRead := make(chan struct{})
+			go func() {
+				stream, e := server.AcceptStream()
+				if e != nil {
+					return
+				}
+				var buf [512]byte
+				_, e = stream.Read(buf[:])
+				if e == nil {
+					close(requestRead)
+				}
+			}()
+			stream, err := client.OpenStream()
+			if err != nil {
+				t.Fatal(err)
+			}
+			c := &Client{loadDiagnostics: h}
+			done := make(chan error, 1)
+			go func() { done <- c.sendConnectRequest(stream, target.host, 443) }()
+			<-requestRead
+			awaitLoadStage(t, h, "stage=CONNECT_ACK class="+target.class+" lane=DATA active=1")
+			_ = server.Close()
+			<-done
+			awaitLoadStage(t, h, "stage=CONNECT_ACK class="+target.class+" lane=DATA active=0")
+		})
+	}
+}
+
+type loadBlockedWriter struct{ entered, release chan struct{} }
+
+func (w loadBlockedWriter) Write(p []byte) (int, error) {
+	close(w.entered)
+	<-w.release
+	return len(p), nil
+}
+
+func TestLoadDiagnosticsHeadWriteOutstanding(t *testing.T) {
+	h := loaddiag.New()
+	defer h.Retire()
+	w := loadBlockedWriter{make(chan struct{}), make(chan struct{})}
+	job := connectJob{host: "192.0.2.1", head: []byte("head"), replied: true, loadDiagnostics: h}
+	done := make(chan bool, 1)
+	defer func() { close(w.release); <-done }()
+	go func() { done <- job.open(nil, w) }()
+	<-w.entered
+	awaitLoadStage(t, h, "stage=HEAD_WRITE class=NUMERIC_TCP lane=DATA active=1")
+}
