+// ai-generated: static server-owned UDP upstream, distinct from the accepted TCP selector.
+type SOCKSProxyConfig struct {
+	Address    string
+	Port       int
+	User, Pass string
+}
+
+// ai-generated: optional managed v2 configuration; nil remains legacy/default off.
+type ManagedUDPConfig struct {
+	Version       uint8
+	Upstream      SOCKSProxyConfig
+	FinalObserver ManagedMeterFinalObserveFunc
+}
+
+//nolint:gochecknoglobals // Fixed sentinel carries no configuration data or mutable authority.
+var ErrManagedUDPConfig = errors.New("invalid managed UDP config")
+
+// ai-generated: static opt-in validation runs before key, transport or callback work and never enables UDP.
+func validateManagedUDPConfig(cfg Config) error {
+	udp := cfg.ManagedUDP
+	if udp == nil {
+		return nil
+	}
+	if udp.Version != 2 || !cfg.RequireAuthHook || !cfg.RequireLease || !cfg.RequireMeter ||
+		cfg.ManagedLeaseAuthHook == nil || cfg.ManagedMeterReporter == nil || udp.FinalObserver == nil {
+		return ErrManagedUDPConfig
+	}
+	proxy := udp.Upstream
+	if !validManagedUDPProxyAddress(proxy.Address) || proxy.Port < 1 || proxy.Port > 65535 ||
+		(proxy.User == "") != (proxy.Pass == "") || len(proxy.User) > 255 || len(proxy.Pass) > 255 {
+		return ErrManagedUDPConfig
+	}
+	return nil
+}
+
+// ai-generated: validate only syntax of server-owned proxy host/IP, never resolve or judge user destinations.
+func validManagedUDPProxyAddress(address string) bool {
+	if address == "" || strings.TrimSpace(address) != address {
+		return false
+	}
+	if _, err := netip.ParseAddr(address); err == nil {
+		return true
+	}
+	name := strings.TrimSuffix(address, ".")
+	if len(name) == 0 || len(name) > 253 {
+		return false
+	}
+	for _, label := range strings.Split(name, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, char := range label {
+			if char != '-' && (char < 'a' || char > 'z') && (char < 'A' || char > 'Z') && (char < '0' || char > '9') {
+				return false
+			}
+		}
+	}
+	return true
+}
