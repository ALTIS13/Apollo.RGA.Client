+
+// ai-generated: catches an expiry-capped renewal cutting an otherwise active
+// finite session, or equality rearming its timer/extending retained authority.
+func TestRelayLeaseCapEqualityIsNoOp(t *testing.T) {
+	var r leaseRegistry
+	deadline := time.Now().Add(20*time.Second)
+	e, err := r.prepare(context.Background(), ManagedLease{SessionID: "relay-cap-equality-001", NotAfter: deadline, ByteLimit: 100})
+	if err != nil || !r.activate(e) { t.Fatal("active finite lease setup failed") }
+	e.timer = time.NewTimer(time.Hour)
+	e.timer.Stop()
+	defer e.timer.Stop()
+	retain, generation, lease := e.retainTo, e.generation, e.lease
+	if !r.renew(lease.SessionID, deadline) { t.Fatal("active capped renewal denied") }
+	if e.lease != lease || !e.retainTo.Equal(retain) || e.generation != generation || e.timer.Stop() {
+		t.Fatal("equal renewal changed authority or rearmed stopped timer")
+	}
+	r.revoke(lease.SessionID)
+	if r.renew(lease.SessionID, deadline) { t.Fatal("equal renewal revived revoked lease") }
+}
+
+// ai-generated: equal renewal cannot bypass existing state/cancellation/expiry
+// gates; an earlier end remains invalid.
+func TestRelayLeaseEqualityPreservesCutoffGates(t *testing.T) {
+	for _, kind := range []string{"pending", "closed", "cancelled", "expired", "earlier"} {
+		t.Run(kind, func(t *testing.T) {
+			var r leaseRegistry
+			ctx, cancel := context.WithCancel(context.Background()); defer cancel()
+			end := time.Now().Add(20*time.Second)
+			e, err := r.prepare(ctx, ManagedLease{SessionID: "relay-negative-cap-001", NotAfter: end})
+			if err != nil { t.Fatal(err) }
+			if kind != "pending" && !r.activate(e) { t.Fatal("activate") }
+			switch kind {
+			case "closed": r.finish(e)
+			case "cancelled": cancel()
+			case "expired": e.lease.NotAfter = time.Now().Add(-time.Second); end = e.lease.NotAfter
+			case "earlier": end = end.Add(-time.Second)
+			}
+			if r.renew(e.lease.SessionID, end) { t.Fatal("invalid finite renewal accepted") }
+		})
+	}
+}
