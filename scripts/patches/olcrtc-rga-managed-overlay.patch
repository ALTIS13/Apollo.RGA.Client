+
+func TestMandatoryPublicPrefixSniffsDeniedTLSAndHTTPBeforeDirect(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		head func(*testing.T) []byte
+	}{
+		{"tls", func(t *testing.T) []byte { return clientHello(t, "vk.cc") }},
+		{"http", func(*testing.T) []byte { return []byte("GET / HTTP/1.1\r\nHost: ICQ.AT.\r\n\r\n") }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var directDials atomic.Int32
+			protect.SetProtector(func(int) bool { directDials.Add(1); return false })
+			t.Cleanup(func() { protect.SetProtector(nil) })
+			head := tc.head(t)
+			errs := make(chan error, 4)
+			c, srv := newStreamTestClient(t, mustRules(t,
+				"tunnel-domain:cc\ntunnel-domain:at\ndomain:vk.cc\ndomain:icq.at\n203.0.113.0/24\n"),
+				0, echoAfterHead(t, head, errs))
+			conn := socksConnect(t, c, "203.0.113.8", 443)
+			_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if rep := readReply(t, conn); rep != socksRepSuccess {
+				t.Fatalf("reply = %#x, expected bounded sniff before any direct dial", rep)
+			}
+			if _, err := conn.Write(head); err != nil {
+				t.Fatal(err)
+			}
+			expectEcho(t, conn)
+			select {
+			case req := <-srv.requests:
+				if req["addr"] != "203.0.113.8" || req["port"] != float64(443) {
+					t.Fatalf("tunnel request = %v", req)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("denied hostname never reached tunnel")
+			}
+			if directDials.Load() != 0 {
+				t.Fatal("denied hostname attempted a direct socket or literal fallback")
+			}
+			noErrors(t, errs)
+			noErrors(t, srv.errs)
+		})
+	}
+}
+
