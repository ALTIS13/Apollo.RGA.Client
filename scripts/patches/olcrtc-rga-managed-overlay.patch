+// ai-generated: one reader reuses the full buffer and rejects invalid/oversize packets before any output copy.
+func (a *managedUDPAssociation) ReadDatagram(output []byte) (udpwire.Endpoint, int, error) {
+	a.readMu.Lock()
+	defer a.readMu.Unlock()
+	n, err := a.relay.Read(a.readBuffer[:])
+	if err != nil {
+		return udpwire.Endpoint{}, 0, fmt.Errorf("UDP packet read: %w", err)
+	}
+	endpoint, payload, err := decodeSocks5UDPPacket(a.readBuffer[:n])
+	if err != nil {
+		return udpwire.Endpoint{}, 0, fmt.Errorf("UDP reply: %w", err)
+	}
+	if err = validateManagedUDPDestination(endpoint); err != nil {
+		return udpwire.Endpoint{}, 0, err
+	}
+	if len(payload) > udpwire.MaxPayloadSize {
+		return udpwire.Endpoint{}, 0, udpwire.ErrPayloadTooLarge
+	}
+	if len(output) < len(payload) {
+		return udpwire.Endpoint{}, 0, io.ErrShortBuffer
+	}
+	return endpoint, copy(output, payload), nil
+}
+
+// ai-generated: detach lifecycle ownership atomically, then interrupt both sockets outside every lifecycle/I/O lock.
+func (a *managedUDPAssociation) Close() error {
+	a.closeMu.Lock()
+	if a.closed {
+		a.closeMu.Unlock()
+		return nil
+	}
+	a.closed = true
+	control, relay, stop := a.control, a.relay, a.stopCaller
+	a.stopCaller = nil
+	a.closeMu.Unlock()
+	if stop != nil {
+		stop()
+	}
+	var first, second error
+	if control != nil {
+		first = control.Close()
+	}
+	if relay != nil {
+		second = relay.Close()
+	}
+	if first != nil {
+		return fmt.Errorf("UDP control close: %w", first)
+	}
+	if second != nil {
+		return fmt.Errorf("UDP relay close: %w", second)
+	}
+	return nil
+}
+
+// ai-generated: deny literal special/private destinations without resolving or changing a logical domain.
+func validateManagedUDPDestination(endpoint udpwire.Endpoint) error {
+	host := endpoint.Host
+	if endpoint.Port == 0 || host == "" || len(host) > udpwire.MaxHostLen || strings.TrimSpace(host) != host {
+		return udpwire.ErrInvalidEndpoint
+	}
+	if addr, err := netip.ParseAddr(host); err == nil {
+		if blockedAddr(addr) {
+			return udpwire.ErrInvalidEndpoint
+		}
+		return nil
+	}
+	if strings.ContainsAny(host, "\x00\r\n\t /\\:[]") {
+		return udpwire.ErrInvalidEndpoint
+	}
+	return nil
+}
