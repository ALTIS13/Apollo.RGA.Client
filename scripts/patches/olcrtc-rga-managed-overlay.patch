+	defer func() { _ = c.Close(); <-done }()
+	go func() { _, _ = c.enqueue([]byte("packet")); close(done) }()
+	awaitLoadStage(t, h, "stage=KCP_ENQUEUE class=OTHER lane=DATA active=1")
+}
