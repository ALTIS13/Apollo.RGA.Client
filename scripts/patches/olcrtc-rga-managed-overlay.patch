+	s.requireAuthHook, s.requireLease, s.requireMeter = true, true, true
+	s.liveness = control.Config{Interval: time.Hour, Timeout: time.Hour, Failures: 4}
+	s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+		return ManagedLease{SessionID: "peer-ready-barrier-lease", NotAfter: time.Now().Add(time.Minute), ByteLimit: 4096}, nil
+	}
+	s.meterReporter = func(_ context.Context, report CumulativeReport) (CumulativeReport, error) { return report, nil }
+	s.dialTarget = func(ctx context.Context, _, _ string) (net.Conn, error) {
