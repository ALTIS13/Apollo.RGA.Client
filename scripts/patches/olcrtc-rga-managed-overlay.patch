+			field := "skip_" + kind + "="
+			deadline := time.Now().Add(time.Second)
+			for time.Now().Before(deadline) {
+				s := h.Snapshot()
+				if !strings.Contains(s, field+"0") && strings.Contains(s, field) {
+					if !strings.Contains(s, "flush=0") {
+						t.Fatal("deferred writer tick invented data flush")
