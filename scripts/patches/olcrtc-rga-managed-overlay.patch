+	defer a.writeMu.Unlock()
+	if err = a.relay.SetWriteDeadline(time.Now().Add(time.Second)); err != nil {
+		return 0, fmt.Errorf("UDP write deadline: %w", err)
+	}
+	n, err := a.relay.Write(packet)
+	accepted := min(len(payload), max(0, n-(len(packet)-len(payload))))
+	if err != nil {
+		return accepted, fmt.Errorf("UDP packet write: %w", err)
+	}
+	if n != len(packet) {
+		return accepted, fmt.Errorf("UDP packet write: %w", io.ErrShortWrite)
+	}
+	return accepted, nil
+}
