+package loaddiag
+
+// ai-generated: owner-local diagnostic accumulator contract tests.
+
+import (
+	"context"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestDisabledDiagnosticsAreSilentAndAllocationFree(t *testing.T) {
+	var disabled Handle
+	if disabled.Snapshot() != "" {
+		t.Fatal("disabled diagnostics emitted a snapshot")
+	}
+	if n := testing.AllocsPerRun(100, func() {
+		disabled.Begin(ConnectAck, NumericTCP, Data).End(OK)
+	}); n != 0 {
+		t.Fatalf("disabled hot path allocated: %v", n)
+	}
+}
+
+func TestOutstandingStageReportsAgeBeforeBlockedOperationEnds(t *testing.T) {
+	var clock atomic.Int64
+	clock.Store(1)
+	h := newWithClock(clock.Load)
+	token := h.Begin(ConnectAck, NumericTCP, Data)
+	clock.Store(int64(15*time.Second) + 1)
+	want := "stage=CONNECT_ACK class=NUMERIC_TCP lane=DATA active=1 age_ms=15000"
+	if got := h.Snapshot(); !strings.Contains(got, want) {
+		t.Fatalf("pending CONNECT acknowledgement not visible: %s", got)
+	}
+	token.End(Failed)
+	if got := h.Snapshot(); !strings.Contains(got, "active=0 age_ms=0 last_ms=15000 max_ms=15000 ok=0 failed=1") {
+		t.Fatalf("completed failure did not retain bounded duration/outcome: %s", got)
+	}
+}
+
+func TestRetiredOwnerCannotContaminateReplacement(t *testing.T) {
+	old := New()
+	oldContext := WithOwner(context.Background(), old)
+	oldToken := FromContext(oldContext).Begin(MuxSend, Other, Data)
+	old.Retire()
+	next := New()
+	nextContext := WithOwner(context.Background(), next)
+	oldToken.End(OK)
+	FromContext(oldContext).Begin(MuxSend, Other, Data).End(OK)
+	if old.Snapshot() != "" {
+		t.Fatal("retired owner emitted data")
+	}
+	if got := next.Snapshot(); strings.Contains(got, "stage=MUX_SEND") {
+		t.Fatalf("old unwind contaminated replacement: %s", got)
+	}
+	FromContext(nextContext).Begin(MuxSend, Other, Data).End(OK)
+	if !strings.Contains(next.Snapshot(), "stage=MUX_SEND") {
+		t.Fatal("replacement owner failed to observe its own operation")
+	}
+}
+
+func TestBlockedExternalConsumerCannotBlockCountersOrRetirement(t *testing.T) {
+	h := New()
+	consumerEntered, release := make(chan struct{}), make(chan struct{})
+	defer close(release)
+	go func() {
+		_ = h.Snapshot()
+		close(consumerEntered)
+		<-release // external sink, never called by the diagnostic hot path
+	}()
+	<-consumerEntered
+	done := make(chan struct{})
+	go func() {
+		h.Begin(TrackWrite, Other, Shared).End(OK)
+		h.Retire()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("external consumer backpressure blocked traffic observation/Stop")
+	}
+}
+
+func TestFiniteOutputAndSaturationNeverCreateDynamicFields(t *testing.T) {
+	h := New()
