+func managedClientRecord(t *testing.T, k *cryptopkg.KeySet, token byte, id uint64, typ udpwire.FrameType, payload string) []byte {
+	t.Helper()
+	w := managedWelcome(token)
+	f := udpwire.Frame{Type: typ, FlowID: id}
+	if typ == udpwire.FrameTypePacket {
+		f.Endpoint = udpwire.Endpoint{Host: "203.0.113.40", Port: 4444}
+		f.Payload = []byte(payload)
