+	defer l.mu.Unlock()
+	l.sent = append(l.sent, append([]byte(nil), b...))
+	return nil
+}
+func (l *managedClientLane) packets() [][]byte {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([][]byte(nil), l.sent...)
