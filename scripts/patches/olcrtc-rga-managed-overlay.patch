+func TestLoadDiagnosticsWriterDeferralCounters(t *testing.T) {
+	for _, kind := range []string{"control", "udp"} {
+		t.Run(kind, func(t *testing.T) {
+			h := loaddiag.New()
+			defer h.Retire()
+			p := &streamTransport{loadDiagnostics: h, data: newDataPlane(1, nil), control: newKCPPlane(1, nil), datagram: make(chan []byte, 1), closeCh: make(chan struct{}), writerDone: make(chan struct{}), frameInterval: time.Millisecond, sampleWriter: func([]byte) bool { return false }}
+			if kind == "control" {
+				p.control.out <- &packetBuffer{data: []byte("control")}
+			} else {
