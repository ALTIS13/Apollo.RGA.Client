+
+// ai-generated: stable errors for unavailable owner authority and entropy input.
+var (
+	//nolint:gochecknoglobals // Stable sentinel for callers, not mutable authority.
+	ErrManagedUDPOwnerDenied = errors.New("managed UDP owner denied")
+	//nolint:gochecknoglobals // Stable sentinel for a missing entropy source.
+	ErrManagedUDPEntropyRequired = errors.New("managed UDP entropy source required")
+)
+
+// ai-generated: finite owner/global flow, pending work, and bilateral packet-rate limits.
+const (
+	managedUDPGlobalFlows   = 1024
+	managedUDPOwnerFlows    = 128
+	managedUDPGlobalPending = 32
+	managedUDPOwnerPending  = 8
+	managedUDPGlobalRate    = 4000
+	managedUDPGlobalBurst   = 512
+	managedUDPOwnerRate     = 1000
+	managedUDPOwnerBurst    = 256
+)
+
+// ai-generated: captures immutable lease identity, child context, and an external current predicate.
+// The predicate owns registry/binding synchronization and runs outside structural locks.
+// Registration is a drain barrier, not independent packet-send authorization.
+type managedUDPOwner struct {
+	entry      *managedLeaseEntry
+	generation uint64
+	token      udpwire.GenerationToken
+	ctx        context.Context
+	cancel     context.CancelFunc
+	currentFn  func() bool
+
+	mu             sync.Mutex
+	closed         atomic.Bool // Written under mu; budget may read without taking mu.
+	operations     int
+	drained        chan struct{}
+	cleanup        func() // Captured owner handles only; set under mu before publication.
+	retiredCleanup func()
+
+	budget      atomic.Pointer[managedUDPBudget] // One budget for this owner lifetime.
+	flowTotal   int                              // Protected by that budget's mu.
+	flowPending int                              // Protected by that budget's mu.
+	rate        managedUDPRateBucket             // Protected by that budget's mu.
+}
+
+// ai-generated: obtains an opaque token from the supplied entropy source, with no fallback.
+func newManagedUDPGenerationToken(reader io.Reader) (udpwire.GenerationToken, error) {
+	if reader == nil {
+		return udpwire.GenerationToken{}, ErrManagedUDPEntropyRequired
+	}
+	var token udpwire.GenerationToken
+	if _, err := io.ReadFull(reader, token[:]); err != nil {
+		return udpwire.GenerationToken{}, fmt.Errorf("managed UDP generation entropy: %w", err)
+	}
+	return token, nil
+}
+
+// ai-generated: derives an owner-only cancellation scope from immutable entry.ctx.
+// Mutable state and NotAfter are read only by current, under its external lock.
+func newManagedUDPOwner(entry *managedLeaseEntry, token udpwire.GenerationToken, current func() bool) (*managedUDPOwner, error) {
+	if entry == nil || current == nil || !current() || entry.ctx == nil {
+		return nil, ErrManagedUDPOwnerDenied
+	}
+	ctx, cancel := context.WithCancel(entry.ctx)
+	if ctx.Err() != nil {
+		cancel()
+		return nil, ErrManagedUDPOwnerDenied
+	}
+	return &managedUDPOwner{
+		entry: entry, generation: entry.generation, token: token,
+		ctx: ctx, cancel: cancel, currentFn: current, drained: make(chan struct{}),
+	}, nil
+}
+
+// ai-generated: rechecks retirement/cancellation around the registry-owned predicate.
+func (o *managedUDPOwner) current() bool {
+	if o == nil || o.closed.Load() || o.ctx.Err() != nil {
+		return false
+	}
+	return o.currentFn() && !o.closed.Load() && o.ctx.Err() == nil
+}
+
+// ai-generated: serializes begin with retirement; completion is idempotent.
+func (o *managedUDPOwner) tryBeginOperation() (func(), bool) {
+	if !o.current() {
+		return nil, false
+	}
+	o.mu.Lock()
+	if o.closed.Load() || o.ctx.Err() != nil {
+		o.mu.Unlock()
+		return nil, false
+	}
+	o.operations++
+	o.mu.Unlock()
+	return sync.OnceFunc(func() {
+		o.mu.Lock()
+		defer o.mu.Unlock()
+		o.operations--
+		if o.closed.Load() && o.operations == 0 {
+			close(o.drained)
+		}
+	}), true
+}
+
+// ai-generated: retires only this owner and returns captured cleanup for execution outside locks.
+// Repeat calls return the same once-only action; parent/TCP lease cancellation is not changed.
+func (o *managedUDPOwner) retire() func() {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.closed.Load() {
+		o.closed.Store(true)
+		cleanup := o.cleanup
+		o.cleanup = nil
+		o.retiredCleanup = sync.OnceFunc(func() {
+			o.cancel()
+			if cleanup != nil {
+				cleanup()
+			}
+		})
+		if o.operations == 0 {
+			close(o.drained)
+		}
+	}
+	return o.retiredCleanup
+}
+
+// ai-generated: a close-and-zero latch avoids concurrent WaitGroup Add/Wait misuse.
+func (o *managedUDPOwner) waitDrained(ctx context.Context) bool {
+	select {
+	case <-o.drained:
+		return true
+	default:
+	}
+	select {
+	case <-o.drained:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+// ai-generated: one shared finite ledger without an owner-state map or cleanup I/O.
+type managedUDPBudget struct {
+	mu      sync.Mutex
+	total   int
+	pending int
+	rate    managedUDPRateBucket
+}
+
+// ai-generated: a once-released slot includes pending capacity until activation.
+type managedUDPFlowSlot struct {
+	budget   *managedUDPBudget
+	owner    *managedUDPOwner
+	active   bool // All slot fields after publication are protected by budget.mu.
+	released bool
+}
+
+// ai-generated: a bounded monotonic token bucket embedded in its admitted owner or global budget.
+type managedUDPRateBucket struct {
+	initialized bool
+	last        time.Time
+	tokens      float64
+}
+
+// ai-generated: creates an empty global ledger; owner state remains with its bounded owner.
+func newManagedUDPBudget() *managedUDPBudget {
+	return &managedUDPBudget{}
+}
+
+// ai-generated: binds one live owner lifetime to one ledger, without structural lock nesting.
+func (b *managedUDPBudget) accepts(o *managedUDPOwner) bool {
+	if b == nil || !o.current() {
+		return false
+	}
+	if o.budget.CompareAndSwap(nil, b) {
+		return true
+	}
+	return o.budget.Load() == b
+}
+
+// ai-generated: reserves pending and total capacity before any future dial/work.
+func (b *managedUDPBudget) reserveFlow(o *managedUDPOwner) (*managedUDPFlowSlot, bool) {
+	if !b.accepts(o) {
+		return nil, false
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if o.closed.Load() || o.ctx.Err() != nil || b.total >= managedUDPGlobalFlows ||
+		o.flowTotal >= managedUDPOwnerFlows || b.pending >= managedUDPGlobalPending ||
+		o.flowPending >= managedUDPOwnerPending {
+		return nil, false
+	}
+	b.total++
+	b.pending++
+	o.flowTotal++
+	o.flowPending++
+	return &managedUDPFlowSlot{budget: b, owner: o}, true
+}
+
+// ai-generated: activates once only while the captured owner is still current.
+func (s *managedUDPFlowSlot) activate() bool {
+	if !s.owner.current() {
+		return false
+	}
+	b := s.budget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if s.released || s.active || s.owner.closed.Load() || s.owner.ctx.Err() != nil {
+		return false
+	}
+	s.active = true
+	b.pending--
+	s.owner.flowPending--
+	return true
+}
+
+// ai-generated: refunds each reserved capacity exactly once, including retired pending work.
+func (s *managedUDPFlowSlot) release() {
+	b := s.budget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if s.released {
+		return
+	}
+	s.released = true
+	b.total--
+	s.owner.flowTotal--
+	if !s.active {
+		b.pending--
+		s.owner.flowPending--
+	}
+}
+
+// ai-generated: applies both bilateral packet rates, without resetting state at zero flows.
+func (b *managedUDPBudget) allowPacket(o *managedUDPOwner, now time.Time) bool {
+	if !b.accepts(o) {
+		return false
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if o.closed.Load() || o.ctx.Err() != nil {
+		return false
+	}
+	b.rate.refill(now, managedUDPGlobalRate, managedUDPGlobalBurst)
+	o.rate.refill(now, managedUDPOwnerRate, managedUDPOwnerBurst)
+	if b.rate.tokens < 1 || o.rate.tokens < 1 {
+		return false
+	}
+	b.rate.tokens--
+	o.rate.tokens--
+	return true
+}
+
+// ai-generated: backward time neither mints credit nor regresses the refill timestamp.
+func (r *managedUDPRateBucket) refill(now time.Time, rate, burst float64) {
+	if !r.initialized {
+		r.initialized = true
+		r.last = now
+		r.tokens = burst
+		return
+	}
+	if elapsed := now.Sub(r.last); elapsed > 0 {
+		r.tokens = min(burst, r.tokens+elapsed.Seconds()*rate)
+		r.last = now
+	}
+}
