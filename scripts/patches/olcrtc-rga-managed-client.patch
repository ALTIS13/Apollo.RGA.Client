+++ b/internal/client/managed_join_test.go
@@ -0,0 +1,126 @@
+package client
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/internal/handshake"
+)
+
+// ai-generated: a second control handshake must sign a new nonce, not replay
+// a static proof from the previous native generation/connection.
+func TestManagedJoinSignsEachControlHandshake(t *testing.T) {
+	server, client := newSmuxPair(t)
+	var signed int
+	c := &Client{deviceID: "installation-00001", managedJoin: true,
+		managedJoinClaims: func(context.Context) (map[string]any, error) {
+			signed++
+			return map[string]any{"nonce": fmt.Sprintf("nonce-%d", signed)}, nil
+		}}
+	served := make(chan error, 1)
+	go func() {
+		for _, want := range []string{"nonce-1", "nonce-2"} {
+			s, err := server.AcceptStream()
+			if err != nil {
+				served <- err
+				return
+			}
+			_, _, err = handshake.Server(s, func(_ string, claims map[string]any) (string, error) {
+				if claims["nonce"] != want {
+					return "", errors.New("replayed proof")
+				}
+				return "session-00000001", nil
+			}, "")
+			if err != nil {
+				served <- err
+				return
+			}
+		}
+		served <- nil
+	}()
+	for range 2 {
+		s, _, err := c.controlHandshake(context.Background(), client, time.Second)
+		if err != nil {
+			t.Fatal(err)
+		}
+		s.Close()
+	}
+	if err := <-served; err != nil {
+		t.Fatal(err)
+	}
+	if signed != 2 {
+		t.Fatalf("sign calls=%d", signed)
+	}
+}
+
+// ai-generated: fail before opening any stream if the fresh source is missing,
+// fails, produces malformed claims, or completes after its context was cancelled.
+func TestManagedJoinCannotFallbackToCachedClaims(t *testing.T) {
+	for _, kind := range []string{"missing", "error", "invalid", "cancelled-before", "cancelled-after"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls := 0
+			c := &Client{managedJoin: true, claims: map[string]any{"nonce": "OLD"}}
+			c.managedJoinClaims = func(context.Context) (map[string]any, error) {
+				calls++
+				if kind == "error" {
+					return nil, errors.New("PRIVATE proof must not escape")
+				}
+				if kind == "invalid" {
+					return map[string]any{"nonce": 42}, nil
+				}
+				if kind == "cancelled-after" {
+					cancel()
+				}
+				return map[string]any{"nonce": "fresh"}, nil
+			}
+			if kind == "missing" {
+				c.managedJoinClaims = nil
+			}
+			if kind == "cancelled-before" {
+				cancel()
+			}
+			// nil smux proves failure occurs before the legacy cached path opens it.
+			if _, _, err := c.controlHandshake(ctx, nil, time.Second); err == nil {
+				t.Fatal("fresh proof failure granted handshake")
+			}
+			if kind == "cancelled-before" && calls != 0 {
+				t.Fatal("cancelled owner called signer")
+			}
+		})
+	}
+}
+
+// ai-generated: one signed nonce may be redeemed only once; no parallel hello
+// resend is allowed for managed joins, even while a response is lost/delayed.
+func TestManagedJoinDoesNotRaceNonceRedemption(t *testing.T) {
+	server, client := newSmuxPair(t)
+	setHelloResend(t, 10*time.Millisecond)
+	var count atomic.Int32
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			s, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			count.Add(1)
+			_ = s
+		}
+	}()
+	c := &Client{managedJoin: true, managedJoinClaims: func(context.Context) (map[string]any, error) { return map[string]any{"nonce": "one-use"}, nil }}
+	if _, _, err := c.controlHandshake(context.Background(), client, 120*time.Millisecond); err == nil {
+		t.Fatal("silent server admitted client")
+	}
+	server.Close()
+	<-done
+	if count.Load() != 1 {
+		t.Fatalf("parallel one-use hello count=%d", count.Load())
+	}
+}
diff --git a/internal/client/transport_health33.go b/internal/client/transport_health33.go
new file mode 100644
index 00000000..293469b4
--- /dev/null
+++ b/internal/client/transport_health33.go
@@ -0,0 +1,43 @@
+package client
+
+import (
+	"time"
+
+	"github.com/xtaci/smux"
+)
+
+// TransportHealth is the R33 observation-only reader. Neither ready nor a
+// previous control stream's pong is evidence for the currently installed one.
+func (c *Client) TransportHealth() string {
+	c.sessMu.RLock()
+	defer c.sessMu.RUnlock()
+	if c.runCtx != nil && c.runCtx.Err() != nil {
+		return "CLOSED"
+	}
+	if c.session == nil || c.controlSess == nil || c.controlStrm == nil {
+		return "MISSING"
+	}
+	if c.session.IsClosed() || c.controlSess.IsClosed() {
+		return "MISSING"
+	}
+	select {
+	case <-c.controlStrm.GetDieCh():
+		return "MISSING"
+	default:
+	}
+	if c.transportStream33 != c.controlStrm || c.transportSeen33.IsZero() || c.transportInterval33 <= 0 {
+		return "MISSING"
+	}
+	if time.Since(c.transportSeen33) > 2*c.transportInterval33 {
+		return "STALE"
+	}
+	return "HEALTHY"
+}
+
+func (c *Client) recordTransportPong33(stream *smux.Stream, seen time.Time) {
+	c.sessMu.Lock()
+	defer c.sessMu.Unlock()
+	if c.controlStrm == stream && c.transportStream33 == stream {
+		c.transportSeen33 = seen
+	}
+}
