diff --git a/internal/client/managed_health_test.go b/internal/client/managed_health_test.go
new file mode 100644
index 00000000..aeb0516c
--- /dev/null
+++ b/internal/client/managed_health_test.go
@@ -0,0 +1,83 @@
+package client
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/internal/control"
+	runtimecfg "github.com/openlibrecommunity/olcrtc/internal/runtime"
+	"github.com/xtaci/smux"
+)
+
+// ai-generated: real smux control closure and stream identity, not lifecycle
+// readiness or previous HealthTracker.LastPong, determine transport health.
+func TestManagedHealthActualClosedAndReplacement(t *testing.T) {
+	c := &Client{health: runtimecfg.NewHealthTracker(nil)}
+	reader, ok := any(c).(interface {
+		TransportHealth() string
+		recordTransportPong33(*smux.Stream, time.Time)
+	})
+	if !ok {
+		t.Fatal("MANAGED_HEALTH_ACTUAL_READER_MISSING")
+	}
+	server, session := newSmuxPair(t)
+	stream, err := session.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = server.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+	replacement, err := session.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = server.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	c.runCtx = ctx
+	c.session, c.controlSess, c.controlStrm = session, session, stream
+	c.reconnectMu.Lock() // Delayed OnDeath must not conceal the closed stream.
+	t.Cleanup(func() {
+		cancel()
+		_ = stream.Close()
+		_ = replacement.Close()
+		c.reconnectMu.Unlock()
+		joined := make(chan struct{})
+		go func() { c.wg.Wait(); close(joined) }()
+		select {
+		case <-joined:
+		case <-time.After(3 * time.Second):
+			t.Error("health fixture control workers not joined")
+		}
+	})
+	c.startControlLoop(ctx, Config{Liveness: control.Config{Interval: time.Hour, Timeout: time.Hour, Failures: 4}}, cancel, stream)
+	if got := reader.TransportHealth(); got != "HEALTHY" {
+		t.Fatalf("actual installed control=%s", got)
+	}
+	reader.recordTransportPong33(stream, time.Now().Add(-3*time.Hour))
+	if got := reader.TransportHealth(); got != "STALE" {
+		t.Fatalf("same-stream stale evidence=%s", got)
+	}
+	c.sessMu.Lock()
+	c.controlStrm = replacement
+	c.sessMu.Unlock()
+	c.health.RecordPong(control.Health{LastSeen: time.Now()})
+	reader.recordTransportPong33(stream, time.Now())
+	if got := reader.TransportHealth(); got != "MISSING" {
+		t.Fatalf("previous stream pong revived replacement=%s", got)
+	}
+	c.sessMu.Lock()
+	c.controlStrm = stream
+	c.sessMu.Unlock()
+	_ = stream.Close()
+	if got := reader.TransportHealth(); got != "MISSING" {
+		t.Fatalf("closed control treated as stale/healthy=%s", got)
+	}
+	cancel()
+	if got := reader.TransportHealth(); got != "CLOSED" {
+		t.Fatalf("cancelled actual run=%s", got)
+	}
+}
diff --git a/internal/client/managed_join.go b/internal/client/managed_join.go
new file mode 100644
index 00000000..45b9dc34
--- /dev/null
+++ b/internal/client/managed_join.go
@@ -0,0 +1,54 @@
+package client
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+	"unicode/utf8"
+
+	"github.com/openlibrecommunity/olcrtc/internal/handshake"
+	"github.com/xtaci/smux"
+)
+
+//nolint:gochecknoglobals // immutable redacted sentinel; no proof/source error escapes.
+var errManagedJoin = errors.New("managed join denied")
+
+// ai-generated: local claims are refreshed before each initial/reconnect
+// handshake under the same attempt context. This function is never called by
+// a payload CONNECT. Callback ownership transfers its returned map to us.
+func (c *Client) controlHandshake(ctx context.Context, session *smux.Session, timeout time.Duration) (*smux.Stream, handshake.SessionWelcome, error) {
+	if !c.managedJoin {
+		return openManagedControlStreamTimeout(ctx, session, c.deviceID, c.claims, handshake.ClientOptions{UDPContract: c.udpContract}, timeout)
+	}
+	if ctx == nil || ctx.Err() != nil || c.managedJoinClaims == nil || timeout <= 0 {
+		return nil, handshake.SessionWelcome{}, errManagedJoin
+	}
+	attempt, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	claims, err := c.managedJoinClaims(attempt)
+	if err != nil || attempt.Err() != nil || !validManagedClaims(claims) {
+		return nil, handshake.SessionWelcome{}, errManagedJoin
+	}
+	// Do not retain this proof in Client or use it on another reconnect.
+	return openControlAttempt(attempt, session, c.deviceID, claims, handshake.ClientOptions{UDPContract: c.udpContract}, time.Until(deadlineOf(attempt)), true)
+}
+
+// ai-generated: every managed attempt above has a finite derived deadline.
+func deadlineOf(ctx context.Context) time.Time { end, _ := ctx.Deadline(); return end }
+
+// ai-generated: source callbacks cannot smuggle arbitrary structured claims,
+// unbounded allocations or malformed text into a managed handshake.
+func validManagedClaims(claims map[string]any) bool {
+	if len(claims) < 1 || len(claims) > 8 {
+		return false
+	}
+	for key, value := range claims {
+		text, ok := value.(string)
+		if !ok || key == "" || len(key) > 64 || text == "" || len(text) > 1024 || !utf8.ValidString(key) || !utf8.ValidString(text) {
+			return false
+		}
+	}
+	b, err := json.Marshal(claims)
+	return err == nil && len(b) <= 4096
+}
