@@ -0,0 +1,58 @@
+package mobile
+
+import (
+	"context"
+	"unicode/utf8"
+)
+
+// ManagedJoinSigner is a local installation-key callback, not an admission
+// authority. Native invokes it once for every new control handshake, including
+// reconnect, and the RU server independently redeems the resulting proof.
+type ManagedJoinSigner interface{ SignManagedJoin() (string, error) }
+
+// SetManagedJoinSigner explicitly selects managed-v2 admission for this Runtime.
+// A nil/invalid source cannot fall back to previously stored one-shot claims.
+// ai-generated: immutable-per-running-generation mobile callback composition.
+func (r *Runtime) SetManagedJoinSigner(signer ManagedJoinSigner) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.isActiveLocked() {
+		return ErrAlreadyRunning
+	}
+	r.defaults.managedJoin = true
+	r.defaults.claims = nil
+	r.defaults.managedJoinSigner = signer
+	if signer == nil || len(r.defaults.failoverRooms) != 0 {
+		return ErrInvalidConfig
+	}
+	return nil
+}
+
+// ai-generated: capture the source in the Start snapshot. No setter or Start
+// signs a reusable proof, and no external callback error/text escapes native.
+func managedClaimsSource(enabled bool, signer ManagedJoinSigner) func(context.Context) (map[string]any, error) {
+	if !enabled {
+		return nil
+	}
+	return func(ctx context.Context) (map[string]any, error) {
+		if ctx == nil || ctx.Err() != nil || signer == nil {
+			return nil, ErrInvalidConfig
+		}
+		value, err := signer.SignManagedJoin()
+		if err != nil || ctx.Err() != nil || len(value) == 0 || len(value) > maxClaimsJSONBytes || !utf8.ValidString(value) {
+			return nil, ErrInvalidConfig
+		}
+		flat, err := parseClaimsJSON(value)
+		if err != nil || len(flat) == 0 || len(flat) > 8 {
+			return nil, ErrInvalidConfig
+		}
+		claims := make(map[string]any, len(flat))
+		for key, value := range flat {
+			if key == "" || len(key) > 64 || value == "" || len(value) > 1024 {
+				return nil, ErrInvalidConfig
+			}
+			claims[key] = value
+		}
+		return claims, nil
+	}
+}
