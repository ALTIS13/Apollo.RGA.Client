--- /dev/null
+++ b/mobile/managed_health.go
@@ -0,0 +1,69 @@
+package mobile
+
+// transportHealthRun33 identifies one actual client runner, independently of
+// the generation ready latch and of any earlier room in that generation.
+type transportHealthRun33 struct {
+	read func() string
+}
+
+func (r *Runtime) captureTransportHealthReader33(gen *runGeneration, run *transportHealthRun33, read func() string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.isCurrentGenerationLocked(gen) && gen.healthRun33 == run && !gen.stopRequested && run.read == nil {
+		run.read = read
+	}
+}
+
+func (r *Runtime) retireTransportHealthReader33(gen *runGeneration, run *transportHealthRun33) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if gen.healthRun33 == run {
+		gen.healthRun33 = nil
+	}
+}
+
+// TransportHealth reports live native control evidence, never authorization.
+// Detached generations whose shutdown has not joined cannot be hidden by a
+// replacement generation's readiness or reader. State/Start remain unchanged.
+func (r *Runtime) TransportHealth() string {
+	r.mu.Lock()
+	if r.healthUnjoined != 0 {
+		r.mu.Unlock()
+		return "UNKNOWN"
+	}
+	gen := r.current
+	if gen == nil || r.state == stateIdle || r.state == stateStopped {
+		r.mu.Unlock()
+		return "STOPPED"
+	}
+	if gen.stopRequested || r.state == stateStopping {
+		r.mu.Unlock()
+		return "STOPPING"
+	}
+	if r.state != stateRunning || channelClosed(gen.done) {
+		r.mu.Unlock()
+		return "MISSING"
+	}
+	run := gen.healthRun33
+	if run == nil || run.read == nil {
+		r.mu.Unlock()
+		return "UNKNOWN"
+	}
+	read := run.read
+	r.mu.Unlock()
+	value := read()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.healthUnjoined != 0 || !r.isCurrentGenerationLocked(gen) || gen.healthRun33 != run {
+		return "UNKNOWN"
+	}
+	if gen.stopRequested || r.state != stateRunning || channelClosed(gen.done) {
+		return "STOPPING"
+	}
+	switch value {
+	case "HEALTHY", "MISSING", "STALE", "CLOSED":
+		return value
+	default:
+		return "UNKNOWN"
+	}
+}
