+package mobile
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/pkg/olcrtc/client"
+)
+
+// ai-generated: reflection keeps the pre-API RED executable. The observed
+// boundary remains the public Config projection used by the real Start runner.
+func managedHealthAPI(t *testing.T, r *Runtime) interface{ TransportHealth() string } {
+	t.Helper()
+	h, ok := any(r).(interface{ TransportHealth() string })
+	if !ok {
+		t.Fatal("MANAGED_HEALTH_RUNTIME_API_MISSING")
+	}
+	return h
+}
+func managedHealthPublish(t *testing.T, cfg client.Config, read func() string) {
+	t.Helper()
+	f := reflect.ValueOf(cfg).FieldByName("OnTransportHealthReader")
+	if !f.IsValid() || f.Kind() != reflect.Func || f.IsNil() {
+		t.Fatal("MANAGED_HEALTH_PUBLIC_READER_NOT_PROJECTED")
+	}
+	callback, ok := f.Interface().(func(func() string))
+	if !ok {
+		t.Fatal("MANAGED_HEALTH_PUBLIC_READER_WRONG_CONTRACT")
+	}
+	callback(read)
+}
+
+// ai-generated: real mobile Start/ready latch cannot fabricate live health.
+func TestManagedHealthReadyRequiresLiveReader(t *testing.T) {
+	configs := make(chan client.Config, 1)
+	r := configuredRuntime(t, func(ctx context.Context, cfg client.Config, ready func(string)) error {
+		configs <- cfg
+		ready(cfg.LocalAddr)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	h := managedHealthAPI(t, r)
+	defer r.Stop(1000)
+	if got := h.TransportHealth(); got != "STOPPED" {
+		t.Fatal(got)
+	}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	cfg := <-configs
+	if err := r.WaitReady(1000); err != nil {
+		t.Fatal(err)
+	}
+	if got := h.TransportHealth(); got != "UNKNOWN" {
+		t.Fatalf("ready with no native reader=%s", got)
+	}
+	var value atomic.Value
+	value.Store("HEALTHY")
+	managedHealthPublish(t, cfg, func() string { return value.Load().(string) })
+	for _, want := range []string{"HEALTHY", "STALE", "MISSING", "CLOSED", "untrusted"} {
+		value.Store(want)
+		expected := want
+		if want == "untrusted" {
+			expected = "UNKNOWN"
+		}
+		if got := h.TransportHealth(); got != expected {
+			t.Fatalf("live reader=%s want=%s", got, expected)
+		}
+	}
+}
+
+// ai-generated: no callback from the old run/generation or delayed read may
+// turn a stopped or replacement generation healthy.
+func TestManagedHealthGenerationAndStopFence(t *testing.T) {
+	configs := make(chan client.Config, 2)
+	r := configuredRuntime(t, func(ctx context.Context, cfg client.Config, ready func(string)) error {
+		configs <- cfg
+		ready(cfg.LocalAddr)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	h := managedHealthAPI(t, r)
+	defer r.Stop(1000)
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	old := <-configs
+	if err := r.WaitReady(1000); err != nil {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	managedHealthPublish(t, old, func() string { close(entered); <-release; return "HEALTHY" })
+	result := make(chan string, 1)
+	go func() { result <- h.TransportHealth() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("reader not entered")
+	}
+	if err := r.Stop(1000); err != nil {
+		close(release)
+		t.Fatal(err)
+	}
+	if got := h.TransportHealth(); got != "STOPPED" {
+		close(release)
+		t.Fatal(got)
+	}
+	if err := r.Start(); err != nil {
+		close(release)
+		t.Fatal(err)
+	}
+	current := <-configs
+	if err := r.WaitReady(1000); err != nil {
+		close(release)
+		t.Fatal(err)
+	}
+	managedHealthPublish(t, old, func() string { return "HEALTHY" })
+	close(release)
+	select {
+	case got := <-result:
+		if got != "UNKNOWN" {
+			t.Fatalf("late old read=%s", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("old reader unjoined")
+	}
+	if got := h.TransportHealth(); got != "UNKNOWN" {
+		t.Fatalf("old callback revived replacement=%s", got)
+	}
+	managedHealthPublish(t, current, func() string { return "MISSING" })
+	if got := h.TransportHealth(); got != "MISSING" {
+		t.Fatal(got)
+	}
+}
+
+// ai-generated: a real runner still blocked after cancellation must not be
+// laundered to STOPPED, or by the next ready callback to HEALTHY.
+func TestManagedHealthUnjoinedOwnerRemainsUnknown(t *testing.T) {
+	configs := make(chan client.Config, 2)
+	release := make(chan struct{})
+	var calls atomic.Int32
+	r := configuredRuntime(t, func(ctx context.Context, cfg client.Config, ready func(string)) error {
+		first := calls.Add(1) == 1
+		configs <- cfg
+		ready(cfg.LocalAddr)
+		if first {
+			<-release
+		} else {
+			<-ctx.Done()
+		}
+		return ctx.Err()
+	})
+	h := managedHealthAPI(t, r)
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	<-configs
+	if err := r.WaitReady(1000); err != nil {
+		t.Fatal(err)
+	}
+	r.mu.Lock()
+	old := r.current
+	r.mu.Unlock()
+	released := false
+	defer func() {
+		if !released {
+			close(release)
+		}
+		select {
+		case <-old.done:
+		case <-time.After(time.Second):
+			t.Error("old runner unjoined")
+		}
+		_ = r.Stop(1000)
+	}()
+	if err := r.Stop(1); !errors.Is(err, ErrStopTimeout) {
+		t.Fatalf("stop=%v", err)
+	}
+	if got := h.TransportHealth(); got != "UNKNOWN" {
+		t.Fatalf("detached owner=%s", got)
+	}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	current := <-configs
+	if err := r.WaitReady(1000); err != nil {
+		t.Fatal(err)
+	}
+	managedHealthPublish(t, current, func() string { return "HEALTHY" })
+	if got := h.TransportHealth(); got != "UNKNOWN" {
+		t.Fatalf("replacement hid old owner=%s", got)
+	}
+	if err := r.Stop(1000); err != nil {
+		t.Fatal(err)
+	}
+	if got := h.TransportHealth(); got != "UNKNOWN" {
+		t.Fatalf("new finish hid old owner=%s", got)
+	}
+	close(release)
+	released = true
+	select {
+	case <-old.done:
+	case <-time.After(time.Second):
+		t.Fatal("old runner unjoined")
+	}
+	if got := h.TransportHealth(); got != "STOPPED" {
+		t.Fatalf("joined old owner=%s", got)
+	}
+}
