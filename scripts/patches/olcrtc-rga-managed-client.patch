@@ -0,0 +1,138 @@
+package mobile
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/openlibrecommunity/olcrtc/pkg/olcrtc/client"
+)
+
+type joinSigner struct {
+	calls int
+	value string
+	err   error
+}
+
+// ai-generated: test-only external mobile callback boundary.
+func (s *joinSigner) SignManagedJoin() (string, error) {
+	s.calls++
+	if s.value != "" || s.err != nil {
+		return s.value, s.err
+	}
+	return fmt.Sprintf(`{"nonce":"fresh-%d"}`, s.calls), nil
+}
+
+// ai-generated: the real Start snapshot must keep an explicit fresh callback,
+// not evaluate it once during setters/start and then replay static claims.
+func TestManagedJoinMobileStartProjectsFreshSource(t *testing.T) {
+	configs := make(chan client.Config, 1)
+	r := configuredRuntime(t, func(ctx context.Context, cfg client.Config, ready func(string)) error {
+		configs <- cfg
+		ready(cfg.LocalAddr)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	defer r.Stop(1000)
+	s := &joinSigner{}
+	if err := r.SetManagedJoinSigner(s); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	cfg := <-configs
+	if !cfg.ManagedJoin || cfg.ManagedJoinClaims == nil || cfg.Claims != nil || s.calls != 0 {
+		t.Fatal("Start lost fresh mode or eagerly signed a reusable proof")
+	}
+	a, err := cfg.ManagedJoinClaims(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := cfg.ManagedJoinClaims(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a["nonce"] != "fresh-1" || b["nonce"] != "fresh-2" || s.calls != 2 {
+		t.Fatal("mobile source reused nonce")
+	}
+	if err := r.SetManagedJoinSigner(&joinSigner{}); !errors.Is(err, ErrAlreadyRunning) {
+		t.Fatal("live signer was hot-swapped")
+	}
+}
+
+// ai-generated: nil/error/invalid proof and cancelled owners cannot fall back
+// to earlier one-shot JSON; invalid mode configuration remains fail closed.
+func TestManagedJoinMobileRejectsFallbackAndMalformedSource(t *testing.T) {
+	for _, kind := range []string{"nil", "error", "duplicate", "nested", "invalid-utf8", "cancelled", "static-after-managed", "failover"} {
+		t.Run(kind, func(t *testing.T) {
+			r := configuredRuntime(t, blockingReadyRunner)
+			defer r.Stop(1000)
+			s := &joinSigner{}
+			switch kind {
+			case "error":
+				s.err = errors.New("PRIVATE signing failure")
+			case "duplicate":
+				s.value = `{"nonce":"a","nonce":"b"}`
+			case "nested":
+				s.value = `{"nonce":{"nested":"x"}}`
+			case "invalid-utf8":
+				s.value = string([]byte{'{', '"', 'n', '"', ':', '"', 0xff, '"', '}'})
+			}
+			if kind == "nil" {
+				_ = r.SetClaimsJSON(`{"nonce":"OLD"}`)
+				if r.SetManagedJoinSigner(nil) == nil || r.Start() == nil {
+					t.Fatal("nil signer silently used static claims")
+				}
+				return
+			}
+			if err := r.SetManagedJoinSigner(s); err != nil {
+				t.Fatal(err)
+			}
+			if kind == "static-after-managed" {
+				if r.SetClaimsJSON(`{"nonce":"OLD"}`) == nil || r.Start() == nil {
+					t.Fatal("static setter downgraded managed mode")
+				}
+				return
+			}
+			if kind == "failover" {
+				if r.AddFailoverRoom("other-room") == nil {
+					t.Fatal("unsigned room switching accepted")
+				}
+				return
+			}
+			cfg := r.defaults.clientConfig()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if kind == "cancelled" {
+				cancel()
+			}
+			claims, err := cfg.ManagedJoinClaims(ctx)
+			if err == nil || claims != nil {
+				t.Fatal("invalid/cancelled proof returned")
+			}
+			if kind == "cancelled" && s.calls != 0 {
+				t.Fatal("cancelled owner called signer")
+			}
+		})
+	}
+}
+
+// ai-generated: the supervisor re-reads profiles; a live SetRoom must not send
+// the next hop to another room with the old captured installation proof scope.
+func TestManagedJoinRoomScopeSurvivesSupervisorHop(t *testing.T) {
+	r := configuredRuntime(t, blockingReadyRunner)
+	defer r.Stop(1000)
+	if err := r.SetManagedJoinSigner(&joinSigner{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	_ = r.SetRoom("https://other.example.org/unbound")
+	profiles := r.profilesSnapshot()
+	if len(profiles) != 1 || profiles[0].Config.RoomID != testRoom {
+		t.Fatal("captured signer followed unsigned room replacement")
+	}
+}
