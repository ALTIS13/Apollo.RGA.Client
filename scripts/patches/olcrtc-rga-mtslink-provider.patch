--- /dev/null
+++ b/internal/auth/mtslink/mtslink.go
@@ -0,0 +1,136 @@
+package mtslink
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"net/http"
+	"net/url"
+
+	"github.com/openlibrecommunity/olcrtc/internal/auth"
+	"github.com/openlibrecommunity/olcrtc/internal/protect"
+	"github.com/openlibrecommunity/olcrtc/internal/roomhint"
+)
+
+// defaultNickname is what a guest is called when the caller names none; the
+// service refuses an empty one (400 ERROR_BAD_REQUEST).
+const defaultNickname = "Р“РѕСЃС‚СЊ"
+
+// Provider produces mtslink engine credentials for the MTS Link service.
+//
+// gateway overrides the API the provider talks to; empty means the measured
+// production one. Only tests set it.
+type Provider struct {
+	gateway string
+}
+
+// New returns an MTS Link auth provider against the production gateway.
+func New() Provider { return Provider{} }
+
+// Engine reports which engine consumes credentials from this auth provider.
+func (Provider) Engine() string { return "mtslink" }
+
+// DefaultServiceURL returns the MTS Link service URL.
+func (Provider) DefaultServiceURL() string { return webOrigin }
+
+func (Provider) newClient(cfg auth.Config) *http.Client {
+	resolver := cfg.Resolver
+	if resolver == nil {
+		resolver = protect.NewResolver(cfg.DNSServer)
+	}
+	return protect.NewHTTPClient(resolver)
+}
+
+// Issue walks a guest into the room and returns what the mtslink engine joins
+// with:
+//
+//	URL   - the SFU room join (the offer goes in, the answer comes out), with
+//	        everything that names the guest; the engine adds what describes
+//	        its offer.
+//	Token - the guest's cookies, for the gateway only: the SFU reads none.
+//	Extra - gateway, sessionId, userId and conferenceId, for the engine to
+//	        take its conference back with after a join that failed.
+//
+// cfg.RoomURL is the event join link the platform stores. Every call makes a
+// new guest: the cookies of one are of no use to the next process, and a
+// guest that is gone leaves nothing behind in the room.
+func (p Provider) Issue(ctx context.Context, cfg auth.Config) (auth.Credentials, error) {
+	room, ice := roomhint.Split(cfg.RoomURL)
+	// RGA pins explicit ice=tcp in both endpoints of its new MTS locator.
+	event, session, err := parseEventLink(room)
+	if err != nil {
+		return auth.Credentials{}, err
+	}
+	gateway := p.gateway
+	if gateway == "" {
+		gateway = defaultGateway
+	}
+	client := p.newClient(cfg)
+	defer client.CloseIdleConnections()
+
+	if session == "" {
+		if session, err = eventSession(ctx, client, gateway, event); err != nil {
+			return auth.Credentials{}, err
+		}
+	}
+	nickname := cfg.Name
+	if nickname == "" {
+		nickname = defaultNickname
+	}
+	g, err := guestLogin(ctx, client, gateway, session, nickname)
+	if err != nil {
+		return auth.Credentials{}, err
+	}
+	server, err := mediaServer(ctx, client, gateway, session, g)
+	if err != nil {
+		return auth.Credentials{}, err
+	}
+	conf, err := newConference(ctx, client, gateway, session, g)
+	if err != nil {
+		return auth.Credentials{}, err
+	}
+	token, err := joinToken(ctx, client, gateway, session, g)
+	if err != nil {
+		// The conference is made and nothing will join it: take it back
+		// rather than leave it in the room's list for good.
+		_ = leave(ctx, client, gateway, conf.id, g.cookies)
+		return auth.Credentials{}, err
+	}
+
+	extra := map[string]string{
+		"gateway": gateway, "sessionId": session, "userId": g.userID, "conferenceId": conf.id,
+	}
+	if ice != roomhint.ICEDefault {
+		// ai-generated: the link's ICE hint, for the engine (roomhint).
+		extra["ice"] = ice
+	}
+	return auth.Credentials{
+		URL:   roomJoinURL(server, session, g.userID, nickname, token, conf.publishToken),
+		Token: g.cookies,
+		Extra: extra,
+	}, nil
+}
+
+// roomJoinURL is the SFU join the web client issues for a meeting, as far as
+// it names the guest (measured 2026-10-11):
+//
+//	POST https://{rtcServer}/rtc/room/{sessionId}/join
+//	     ?userId=&joinToken=&disableRecording=true&userName=&publishToken=&did=&pid=
+//
+// did and pid are the web client's device and page ids, sixteen hex digits
+// each, the second the first turned by one digit. What describes the offer -
+// twcc, originMid, preferredPublishCodec - is the engine's to add.
+func roomJoinURL(server, session, userID, nickname, joinToken, publishToken string) string {
+	var raw [8]byte
+	_, _ = rand.Read(raw[:])
+	did := hex.EncodeToString(raw[:])
+	q := url.Values{}
+	q.Set("userId", userID)
+	q.Set("joinToken", joinToken)
+	q.Set("disableRecording", yes)
+	q.Set("userName", nickname)
+	q.Set("publishToken", publishToken)
+	q.Set("did", did)
+	q.Set("pid", did[1:]+did[:1])
+	return "https://" + server + "/rtc/room/" + session + "/join?" + q.Encode()
+}
diff --git a/internal/auth/mtslink/mtslink_test.go b/internal/auth/mtslink/mtslink_test.go
new file mode 100644
--- /dev/null
+++ b/internal/auth/mtslink/mtslink_test.go
@@ -0,0 +1,391 @@
+package mtslink
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/openlibrecommunity/olcrtc/internal/auth"
+)
+
+const (
+	testEvent   = "20300400500"
+	testSession = "20300400600"
+	testOwner   = "100200300"
+	testLink    = "https://my.mts-link.ru/j/" + testOwner + "/" + testEvent
+)
+
+// The gateway's own answers, as it gave them on 2026-10-11 (ids kept, tokens
+// replaced). The tests below answer with these and nothing invented.
+const (
+	replyEvent = `{"id":20300400500,"access":1,"type":"meeting","status":"ACTIVE","isEndless":true,` +
+		`"eventSessions":[{"id":20300400600,"access":1,"type":"meeting","status":"START"}]}`
+	replyGuestLogin = `{"isAccepted":true,"participationId":1485424883,"user":{"sessionId":"529e1f7db49244b035d47e8c4eca75f4"},` +
+		`"participation":{"id":1485424883,"name":"","nickname":"cap-a","isOnline":false,"isAccepted":true,"role":"GUEST",` +
+		`"event":{"id":20300400500},"user":{"id":100200999,"type":"GUEST","isDeleted":false,"nickname":"cap-a"},` +
+		`"eventSession":{"id":20300400600},"registerStatus":"INVITED"}}`
+	replyConfiguration = `{"hlsServer":"events-delivery-files.webinar.ru","rtcServer":"sfu.mts-link.ru",` +
+		`"mediaServer":"live-sd.webinar.ru","rtcUrl":"\/\/sfu.mts-link.ru\/event\/20300400600\/rtc",` +
+		`"cometServer":"msg-edge-5.webinar.ru","rtcActiveSpeakerServer":"sfu.mts-link.ru"}`
+	replyConference = `{"id":395296501,"isDeleted":false,"createAt":"2026-10-11T15:46:04+03:00",` +
+		`"privateKey":"vcPRIVATE0000000000000000000000000","publicKey":"vcPUBLIC00000000000000000000000000",` +
+		`"userId":100200999,"user":{"id":100200999,"nickname":"cap-a"},"status":"PUBLISH","size":"SMALL",` +
+		`"hasStream":false,"hasVideo":true,"hasAudio":false,"typeMedia":"conference","participationId":1485424883}`
+	replyJoinToken    = `{"data":{"joinToken":"vcJOIN000000000000000000000000000"}}`
+	replyGone         = `{"error":{"code":406,"message":"Not Acceptable"}}`
+	replyNoToken      = `{"error":{"code":401,"message":"A Token was not found in the TokenStorage."}}`
+	replyAccessDenied = `{"error":{"code":403,"message":"Access denied"}}`
+)
+
+// gateway is the service behind one test server: it answers the measured
+// shapes, sets the guest cookies at the login, and expects them back on every
+// call that needs them. calls records what was asked, in order.
+type gateway struct {
+	t  *testing.T
+	mu sync.Mutex
+	// calls is "METHOD path" of every request, in order.
+	calls []string
+	// forms is the decoded body of every POST, by path.
+	forms map[string]url.Values
+	// answer overrides the reply of a path: status and body.
+	answer map[string]func(w http.ResponseWriter)
+	// rtcServer is what the configuration names; empty keeps the measured one.
+	rtcServer string
+}
+
+func newGateway(t *testing.T) (*gateway, *httptest.Server) {
+	t.Helper()
+	g := &gateway{t: t, forms: map[string]url.Values{}, answer: map[string]func(http.ResponseWriter){}}
+	srv := httptest.NewServer(g)
+	t.Cleanup(srv.Close)
+	return g, srv
+}
+
+func (g *gateway) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	g.mu.Lock()
+	g.calls = append(g.calls, r.Method+" "+r.URL.Path)
+	if r.Method == http.MethodPost {
+		body, _ := io.ReadAll(r.Body)
+		form, _ := url.ParseQuery(string(body))
+		g.forms[r.URL.Path] = form
+	}
+	override := g.answer[r.URL.Path]
+	g.mu.Unlock()
+	if override != nil {
+		override(w)
+		return
+	}
+
+	guest := func() bool {
+		a, errA := r.Cookie("access")
+		s, errS := r.Cookie("sessionId")
+		return errA == nil && errS == nil && a.Value == "eyJguest.access" && s.Value == "529e1f7db49244b0"
+	}
+	switch r.Method + " " + r.URL.Path {
+	case "GET /api/event/" + testEvent:
+		_, _ = io.WriteString(w, replyEvent)
+	case "POST /api/eventsessions/" + testSession + "/guestlogin":
+		// As the service sets them: Secure, HttpOnly, SameSite=None.
+		for _, pair := range []string{
+			"access=eyJguest.access", "refresh=6074c7a91c56476840728cab1c1b42f5", "sessionId=529e1f7db49244b0",
+		} {
+			w.Header().Add("Set-Cookie", pair+"; Path=/; Domain=.mts-link.ru; Secure; HttpOnly; SameSite=None")
+		}
+		_, _ = io.WriteString(w, replyGuestLogin)
+	case "GET /api/eventsession/" + testSession + "/configuration":
+		if !guest() {
+			w.WriteHeader(http.StatusForbidden)
+			_, _ = io.WriteString(w, replyAccessDenied)
+			return
+		}
+		reply := replyConfiguration
+		if g.rtcServer != "" {
+			reply = strings.ReplaceAll(reply, `"rtcServer":"sfu.mts-link.ru"`, `"rtcServer":"`+g.rtcServer+`"`)
+		}
+		_, _ = io.WriteString(w, reply)
+	case "POST /api/eventsessions/" + testSession + "/conferences":
+		if !guest() {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = io.WriteString(w, replyNoToken)
+			return
+		}
+		w.WriteHeader(http.StatusCreated)
+		_, _ = io.WriteString(w, replyConference)
+	case "GET /api/eventsessions/" + testSession + "/join-token":
+		if !guest() {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = io.WriteString(w, replyNoToken)
+			return
+		}
+		_, _ = io.WriteString(w, replyJoinToken)
+	case "DELETE /api/conferences/395296501":
+		if !guest() {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = io.WriteString(w, replyNoToken)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	default:
+		g.t.Errorf("the provider asked for %s %s, which the web client never does", r.Method, r.URL.Path)
+		w.WriteHeader(http.StatusNotAcceptable)
+		_, _ = io.WriteString(w, replyGone)
+	}
+}
+
+func (g *gateway) status(path string, code int, body string) {
+	g.answer[path] = func(w http.ResponseWriter) {
+		w.WriteHeader(code)
+		_, _ = io.WriteString(w, body)
+	}
+}
