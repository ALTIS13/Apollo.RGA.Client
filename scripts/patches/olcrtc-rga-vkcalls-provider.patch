+
+// VK's SFU wraps the existing VP8 packets in RFC2198 RED. This only removes
+// that wrapper; it does not add VP9, change KCP/crypto or reinterpret audio.
+func isVP8CarrierCodec(mime string) bool {
+	return strings.EqualFold(mime, webrtc.MimeTypeVP8) || strings.EqualFold(mime, "video/red")
+}
+
+var errCarrierCodec = errors.New("vp8channel: unsupported carrier codec")
+var errCarrierFEC = errors.New("vp8channel: negotiated FEC packet")
+
+func unwrapVP8CarrierPacket(mime string, pkt *rtp.Packet, codecs map[uint8]string) error {
+	if strings.EqualFold(mime, webrtc.MimeTypeVP8) {
+		return nil
+	}
+	if !strings.EqualFold(mime, "video/red") {
+		return errCarrierCodec
+	}
+	typ, payload, err := common.REDPrimary(pkt.Payload)
+	if err != nil {
+		return err
+	}
+	inner := codecs[typ]
+	if strings.EqualFold(inner, "video/ulpfec") || strings.EqualFold(inner, "video/flexfec-03") {
+		return errCarrierFEC
+	}
+	if !strings.EqualFold(inner, webrtc.MimeTypeVP8) {
+		return errCarrierCodec
+	}
+	pkt.PayloadType = typ
+	pkt.Payload = payload
+	return nil
+}
+
+func (s *vp8FrameState) processCarrierPacket(mime string, pkt *rtp.Packet, codecs map[uint8]string) []byte {
+	if err := unwrapVP8CarrierPacket(mime, pkt, codecs); err != nil {
+		// Reordering precedes demultiplexing. A known FEC packet consumes an
+		// RTP sequence number, not VP8 bytes; malformed/unknown media invalidates
+		// a partial frame. Genuine missing sequence numbers still drop it.
+		gap := s.haveLastSeq && pkt.SequenceNumber != s.lastSeq+1
+		if gap || !errors.Is(err, errCarrierFEC) {
+			s.frameValid = false
+			s.frameBuf = s.frameBuf[:0]
+		}
+		s.lastSeq = pkt.SequenceNumber
+		s.haveLastSeq = true
+		return nil
+	}
+	return s.processRTPPacket(pkt)
 }
 
