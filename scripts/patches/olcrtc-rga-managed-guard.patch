+	"github.com/openlibrecommunity/olcrtc/internal/tunnelcore"
+)
+
+func TestRequireLeaseRejectsMissingTrustedHookBeforeKeySetup(t *testing.T) {
+	err := Run(context.Background(), Config{RequireLease: true})
+	if !errors.Is(err, ErrLeaseHookRequired) {
+		t.Fatalf("RequireLease without trusted hook returned %v, want ErrLeaseHookRequired", err)
+	}
+}
+
+func TestRequireLeaseForcesUDPDisabledWithoutLegacyAuthHook(t *testing.T) {
+	if !effectiveUDPDisabled(Config{RequireLease: true}) {
+		t.Fatal("managed lease mode left UDP available")
+	}
+	if effectiveUDPDisabled(Config{}) {
+		t.Fatal("default non-managed mode changed UDP behavior")
+	}
+}
+
+func TestManagedLeaseInvalidFactsNeverSendWelcome(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		lease ManagedLease
+	}{
+		{name: "empty session", lease: ManagedLease{NotAfter: time.Now().Add(time.Minute)}},
+		{name: "zero deadline", lease: ManagedLease{SessionID: "lease-session-zero"}},
+		{name: "past deadline", lease: ManagedLease{SessionID: "lease-session-past", NotAfter: time.Now().Add(-time.Second)}},
+		{name: "overlong deadline", lease: ManagedLease{SessionID: "lease-session-overlong", NotAfter: time.Now().Add(25 * time.Hour)}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newHandshakeServer()
+			s.requireLease = true
+			s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+				return tc.lease, nil
+			}
+			serverSession, clientSession, cleanup := smuxPair(t)
+			defer cleanup()
+			result := make(chan error, 1)
+			go func() {
+				stream, err := clientSession.OpenStream()
+				if err != nil {
+					result <- err
+					return
+				}
+				_, _, err = handshake.Client(stream, "device", nil)
+				result <- err
+			}()
+			stream, _, ok := s.answerHello(context.Background(), serverSession)
+			if ok || stream != nil {
+				t.Fatal("invalid lease produced a successful handshake")
+			}
+			if err := <-result; !errors.Is(err, handshake.ErrRejected) {
+				t.Fatalf("invalid lease reached client as %v, want reject", err)
+			}
+		})
+	}
+}
+
+func TestManagedLeaseRejectsRevokedIDBeforeWelcome(t *testing.T) {
+	s := newHandshakeServer()
+	s.requireLease = true
+	s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+		return ManagedLease{SessionID: "lease-session-reused", NotAfter: time.Now().Add(time.Minute)}, nil
+	}
+	controller := &SessionController{}
+	if !controller.attach(s) {
+		t.Fatal("could not attach controller")
+	}
+	defer controller.detach(s)
+	if !controller.RevokeLease("lease-session-reused") {
+		t.Fatal("trusted pre-publication revoke was not recorded")
+	}
+	serverSession, clientSession, cleanup := smuxPair(t)
+	defer cleanup()
+	result := make(chan error, 1)
+	go func() {
+		stream, err := clientSession.OpenStream()
+		if err != nil {
+			result <- err
+			return
+		}
+		_, _, err = handshake.Client(stream, "device", nil)
+		result <- err
+	}()
+	stream, _, ok := s.answerHello(context.Background(), serverSession)
+	if ok || stream != nil {
+		t.Fatal("revoked ID produced a successful handshake")
+	}
+	if err := <-result; !errors.Is(err, handshake.ErrRejected) {
+		t.Fatalf("revoked ID reached client as %v, want reject", err)
+	}
+}
+
+func TestManagedLeaseRejectsReusedIDBeforeWelcome(t *testing.T) {
+	s := newHandshakeServer()
+	s.requireLease = true
+	s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+		return ManagedLease{SessionID: "lease-session-reused", NotAfter: time.Now().Add(time.Minute)}, nil
+	}
+	for attempt := 0; attempt < 2; attempt++ {
+		serverSession, clientSession, cleanup := smuxPair(t)
+		result := make(chan error, 1)
+		go func() {
+			stream, err := clientSession.OpenStream()
+			if err == nil {
+				_, _, err = handshake.Client(stream, "device", nil)
+			}
+			result <- err
+		}()
+		stream, hello, ok := s.answerHello(context.Background(), serverSession)
+		clientErr := <-result
+		if attempt == 0 {
+			if !ok || clientErr != nil {
+				t.Fatalf("first lease failed: ok=%v err=%v", ok, clientErr)
+			}
+			s.leases.abort(hello.lease)
+			_ = stream.Close()
