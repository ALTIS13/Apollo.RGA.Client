+func TestManagedMeterAmbiguousRetryHasBoundedBackoff(t *testing.T) {
+	type attempt struct {
+		report CumulativeReport
+		at     time.Time
+	}
+	attempts := make(chan attempt, 4)
+	m := newSessionByteMeter(context.Background(), "meter-backoff-session-001", 10,
+		func(_ context.Context, report CumulativeReport) (CumulativeReport, error) {
+			attempts <- attempt{report: report, at: time.Now()}
+			return CumulativeReport{}, errors.New("ambiguous acknowledgement")
+		}, func() {},
+	)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { m.runReporter(ctx); close(done) }()
+	_, settle, err := m.Reserve(true, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	settle(1)
+	var first, second attempt
+	select {
+	case first = <-attempts:
+	case <-time.After(time.Second):
+		t.Fatal("first attempt was not sent")
+	}
+	select {
+	case second = <-attempts:
+	case <-time.After(2 * time.Second):
+		t.Fatal("retry did not occur within bounded backoff")
+	}
+	if second.report != first.report {
+		t.Fatalf("ambiguous retry changed snapshot: first=%+v second=%+v", first.report, second.report)
+	}
+	if elapsed := second.at.Sub(first.at); elapsed < 200*time.Millisecond {
+		t.Fatalf("retry rate too high: %s between ambiguous attempts", elapsed)
+	}
+	cancel()
+	<-done
+}
