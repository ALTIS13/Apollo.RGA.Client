+func TestManagedByteBudgetAggregatesBothDirectionsAndRefundsShortWrite(t *testing.T) {
+	m := newSessionByteMeter(context.Background(), "meter-budget-session-001", 5, echoMeterAck, func() {})
+	first, settleFirst, err := m.Reserve(true, 4)
+	if err != nil || first != 4 {
+		t.Fatalf("first reservation = %d, %v, want 4", first, err)
+	}
+	second, settleSecond, err := m.Reserve(false, 4)
+	if err != nil || second != 1 {
+		t.Fatalf("opposite direction independently exceeded budget: %d, %v", second, err)
+	}
+	settleFirst(2) // The destination accepted only half; two bytes must be refundable.
+	settleSecond(1)
+	third, settleThird, err := m.Reserve(false, 3)
+	if err != nil || third != 2 {
+		t.Fatalf("short-write refund = %d, %v, want 2", third, err)
+	}
+	settleThird(2)
+	if _, _, err := m.Reserve(true, 1); !errors.Is(err, tunnelcore.ErrWriteBudgetExhausted) {
+		t.Fatalf("sixth byte reservation = %v, want exhausted", err)
+	}
+	up, down := m.currentTotals()
+	if up != 2 || down != 3 {
+		t.Fatalf("committed totals = %d/%d, want 2/3", up, down)
+	}
+}
