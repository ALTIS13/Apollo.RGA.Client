+// revokeManagedSession cuts off only the named managed session. A stale caller
+// cannot close a replacement peer because endPeer checks pointer identity.
+// The managed path skips the graceful close notice so data transport closes
+// before this method returns.
+func (s *Server) revokeManagedSession(sessionID string) bool {
+	if !s.requireAuthHook || sessionID == "" {
+		return false
+	}
+	s.sessMu.RLock()
+	peers := make([]*peerSession, 0, 1)
+	for _, peer := range s.peerSessions {
+		if peer.sid() == sessionID {
+			peers = append(peers, peer)
+		}
+	}
+	s.sessMu.RUnlock()
+	closed := false
+	for _, peer := range peers {
+		if s.endPeer(peer, "revoked", false) {
+			closed = true
+		}
+	}
+	return s.revokeSingleManagedSession(sessionID) || closed
+}
+
+func (s *Server) revokeSingleManagedSession(expectedID string) bool {
+	s.sessMu.Lock()
+	if s.sessionID != expectedID {
+		s.sessMu.Unlock()
+		return false
+	}
+	pair := s.pair
+	session := s.session
+	controlSession := s.controlSess
+	conn := s.conn
+	controlConn := s.controlConn
+	controlStream := s.controlStrm
+	controlStop := s.controlStop
+	s.controlStrm, s.controlStop = nil, nil
+	s.sessionID, s.deviceID = "", ""
+	s.sessMu.Unlock()
+	s.state.broadcast()
+	if controlStop != nil {
+		controlStop()
+	}
+	// A smux stream Close can wait for its FIN to drain. Shut down the data
+	// carrier first, so a stalled control plane cannot delay revocation.
+	if conn != nil {
+		_ = conn.Close()
+	}
+	if session != nil {
+		_ = session.Close()
+	}
+	if controlConn != nil {
+		_ = controlConn.Close()
+	}
+	if pair != nil {
+		_ = pair.Close()
+	} else {
+		closeServerPair(nil, nil, controlSession)
+	}
+	if controlStream != nil {
+		_ = controlStream.Close()
+	}
+	s.onClose(expectedID, "revoked")
+	s.trackPeerClose(expectedID, "revoked")
+	// Keep the closed generation published until the replacement swaps under
+	// sessMu. A blocked serveSingle can then reinstall it, and an isolated
+	// control plane also receives an explicit tracked reinstall attempt.
+	if s.ln != nil && s.ring != nil && !s.stopping() {
+		ctx := s.streamContext()
+		s.goTracked(func() {
+			if !contextDone(ctx) {
+				s.reinstallSession(ctx, session)
+			}
+		})
+	}
+	return true
+}
