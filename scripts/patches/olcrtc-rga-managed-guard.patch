+func TestManagedSingletonRevokeCutsDataBeforeBlockedControlFIN(t *testing.T) {
+	dataServer, _, dataCleanup := smuxPair(t)
+	defer dataCleanup()
+	a, b := net.Pipe()
+	gate := &gatedWriteConn{Conn: a, release: make(chan struct{}), blocked: make(chan struct{})}
+	defer close(gate.release)
+	controlServer, err := smux.Server(gate, testSmuxCfg())
+	if err != nil {
+		t.Fatalf("control smux.Server() error = %v", err)
+	}
+	controlClient, err := smux.Client(b, testSmuxCfg())
+	if err != nil {
+		t.Fatalf("control smux.Client() error = %v", err)
+	}
+	defer func() {
+		_ = controlServer.Close()
+		_ = controlClient.Close()
+		_ = a.Close()
+		_ = b.Close()
+	}()
+	clientStream, err := controlClient.OpenStream()
+	if err != nil {
+		t.Fatalf("control OpenStream() error = %v", err)
+	}
+	defer func() { _ = clientStream.Close() }()
+	serverStream, err := controlServer.AcceptStream()
+	if err != nil {
+		t.Fatalf("control AcceptStream() error = %v", err)
+	}
+	gate.enabled.Store(true)
+	s := &Server{
+		requireAuthHook: true, sessionID: "sid", session: dataServer,
+		controlSess: controlServer, controlStrm: serverStream,
+		onClose: func(string, string) {},
+	}
+	done := make(chan bool, 1)
+	go func() { done <- s.revokeManagedSession("sid") }()
+	select {
+	case <-done:
+	case <-gate.blocked:
+	case <-time.After(time.Second):
+		t.Fatal("revocation did not reach the control stream")
+	}
+	if !dataServer.IsClosed() {
+		t.Fatal("data stayed open while a control FIN could not be written")
+	}
+}
+
+type gatedWriteConn struct {
+	net.Conn
+	enabled atomic.Bool
+	release chan struct{}
+	blocked chan struct{}
+	once    sync.Once
+}
+
+func (c *gatedWriteConn) Write(p []byte) (int, error) {
+	if c.enabled.Load() {
+		c.once.Do(func() { close(c.blocked) })
+		<-c.release
+	}
+	return c.Conn.Write(p)
+}
