+package server
+
+import (
+	"context"
+	"errors"
+	"math"
+	"sync"
+	"time"
+
+	"github.com/openlibrecommunity/olcrtc/internal/tunnelcore"
+)
+
+// CumulativeReport is the node's immutable, monotonic acknowledgement unit.
+// A future trusted adapter must bind SessionID to the admitted subject and
+// return this exact value only after durable RecordCumulative acceptance.
+type CumulativeReport struct {
+	SessionID         string
+	Sequence          int64
+	ClientToExitBytes int64
+	ExitToClientBytes int64
+}
+
+// ManagedMeterReportFunc must return the exact snapshot only after durable
+// acceptance. It must honor ctx deadlines; any error is ambiguous and causes
+// an identical pending snapshot to be retried, never a new sequence.
+type ManagedMeterReportFunc func(context.Context, CumulativeReport) (CumulativeReport, error)
+
+var (
+	ErrMeterRequiresLease    = errors.New("managed meter requires lease mode")
+	ErrMeterReporterRequired = errors.New("managed meter requires trusted reporter")
+)
+
+// sessionByteMeter is the single reservation point for every TCP stream and
+// both directions of one admitted lease. No reporter callback runs in Reserve
+// or settle, so destination writes do not depend on Bridge latency.
+type sessionByteMeter struct {
+	mu          sync.Mutex
+	ctx         context.Context
+	sessionID   string
+	limit       int64
+	reserved    int64
+	clientBytes int64
+	exitBytes   int64
+	ackedClient int64
+	ackedExit   int64
+	sequence    int64
+	pending     *CumulativeReport
+	lastReport  time.Time
+	exhausted   bool
+	closing     bool
+	activeCopy  int
+	closeBy     time.Time
+	closeCh     chan struct{}
+	updates     chan struct{}
+	reporter    ManagedMeterReportFunc
+	onExhausted func()
+}
+
+// meterConnectHold reserves one byte of admission capacity while a target
+// dial is in flight. Its state is protected by the owning meter's mutex.
+type meterConnectHold struct {
+	meter    *sessionByteMeter
+	started  bool
+	released bool
+}
+
+func newSessionByteMeter(ctx context.Context, id string, limit int64, reporter ManagedMeterReportFunc, onExhausted func()) *sessionByteMeter {
+	return &sessionByteMeter{
+		ctx: ctx, sessionID: id, limit: limit, reporter: reporter,
+		onExhausted: onExhausted, closeCh: make(chan struct{}), updates: make(chan struct{}, 1),
+	}
+}
+
+func (m *sessionByteMeter) Reserve(leftToRight bool, requested int) (int, func(int), error) {
+	if requested <= 0 {
+		return 0, func(int) {}, nil
+	}
+	m.mu.Lock()
+	available := m.availableLocked()
+	if m.exhausted || m.closing || m.ctx.Err() != nil {
+		fire := !m.exhausted
+		m.exhausted = true
+		m.mu.Unlock()
+		if fire && m.onExhausted != nil {
+			m.onExhausted()
+		}
+		return 0, nil, tunnelcore.ErrWriteBudgetExhausted
+	}
+	if available <= 0 {
+		// A temporary in-flight reservation (including a connect hold) is
+		// not confirmed exhaustion: its unwritten bytes may still be refunded.
+		fire := available < 0 || m.clientBytes+m.exitBytes == m.limit
+		if fire {
+			m.exhausted = true
+		}
+		m.mu.Unlock()
+		if fire && m.onExhausted != nil {
+			m.onExhausted()
+		}
+		return 0, nil, tunnelcore.ErrWriteBudgetExhausted
+	}
+	allowed := requested
+	if int64(allowed) > available {
+		allowed = int(available)
+	}
+	m.reserved += int64(allowed)
+	m.mu.Unlock()
+	var once sync.Once
+	return allowed, func(written int) {
+		once.Do(func() {
+			m.settle(leftToRight, allowed, written)
+		})
+	}, nil
+}
+
+func (m *sessionByteMeter) settle(leftToRight bool, allowed, written int) {
+	m.mu.Lock()
+	m.reserved -= int64(allowed)
+	invalid := written < 0 || written > allowed
+	if invalid {
+		written = 0
+	}
+	if leftToRight {
+		m.clientBytes += int64(written)
+	} else {
+		m.exitBytes += int64(written)
+	}
+	fullyUsed := m.clientBytes+m.exitBytes == m.limit && m.reserved == 0
+	fire := (invalid || fullyUsed) && !m.exhausted
+	if fire {
+		m.exhausted = true
+	}
+	m.mu.Unlock()
+	if written > 0 {
+		m.wakeReporter()
+	}
+	if fire && m.onExhausted != nil {
+		m.onExhausted()
+	}
+}
+
+func (m *sessionByteMeter) wakeReporter() {
+	select {
+	case m.updates <- struct{}{}:
+	default:
+	}
+}
+
+func (m *sessionByteMeter) availableLocked() int64 {
+	return m.limit - m.clientBytes - m.exitBytes - m.reserved
+}
+
+// holdConnect atomically claims one admission byte before dial. It does not
+// commit traffic; every exit from dispatch releases the hold idempotently.
+func (m *sessionByteMeter) holdConnect() *meterConnectHold {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.exhausted || m.closing || m.ctx.Err() != nil || m.availableLocked() <= 0 {
+		return nil
+	}
+	m.reserved++
+	return &meterConnectHold{meter: m}
+}
+
+func (h *meterConnectHold) release() {
+	if h == nil {
+		return
+	}
+	m := h.meter
+	m.mu.Lock()
+	if !h.released {
+		h.released = true
+		m.reserved--
+	}
+	m.mu.Unlock()
+}
+
+func (h *meterConnectHold) live() bool {
+	if h == nil {
+		return false
+	}
+	m := h.meter
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return !h.released && !m.exhausted && !m.closing && m.ctx.Err() == nil
+}
+
+func (m *sessionByteMeter) beginCopyWithHold(h *meterConnectHold) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if h == nil || h.meter != m || h.released || h.started ||
+		m.exhausted || m.closing || m.ctx.Err() != nil {
+		return false
+	}
+	h.started = true
+	m.activeCopy++
+	return true
+}
+
+func (m *sessionByteMeter) beginCopy() bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.exhausted || m.closing || m.ctx.Err() != nil || m.availableLocked() <= 0 {
+		return false
+	}
+	m.activeCopy++
+	return true
+}
+
+func (m *sessionByteMeter) endCopy() {
+	m.mu.Lock()
+	m.activeCopy--
+	m.mu.Unlock()
+	m.wakeReporter()
+}
+
+const meterReportAttemptTimeout = 500 * time.Millisecond
+const meterReportMinInterval = time.Second
+const meterReportRetryMin = 250 * time.Millisecond
+const meterReportRetryMax = 2 * time.Second
+const meterReportFlushGrace = 2 * time.Second
+
+// close stops new reservations but lets in-flight writes settle and gives the
+// single reporter a bounded chance to flush. Unconfirmed reservation is never
+// returned as an available grant by this process.
+func (m *sessionByteMeter) close() {
+	m.mu.Lock()
+	if !m.closing {
+		m.closing = true
+		m.closeBy = time.Now().Add(meterReportFlushGrace)
+		close(m.closeCh)
+	}
+	m.mu.Unlock()
+	m.wakeReporter()
+}
+
+func (m *sessionByteMeter) failClosed() {
+	m.mu.Lock()
+	fire := !m.exhausted
+	m.exhausted = true
+	m.mu.Unlock()
+	if fire && m.onExhausted != nil {
+		m.onExhausted()
+	}
+}
+
+// runReporter is the only code path allowed to call the trusted reporter.
+// A failed or ambiguous acknowledgement leaves pending immutable until the
+// exact same report is accepted; new writes only change the next snapshot.
+func (m *sessionByteMeter) runReporter(ctx context.Context) {
+	retryDelay := meterReportRetryMin
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		m.mu.Lock()
+		var rateWait time.Duration
+		if m.pending == nil && (m.clientBytes != m.ackedClient || m.exitBytes != m.ackedExit) {
+			if !m.closing && !m.lastReport.IsZero() {
+				rateWait = time.Until(m.lastReport.Add(meterReportMinInterval))
+			}
+			if rateWait <= 0 {
+				if m.sequence == math.MaxInt64 {
+					m.mu.Unlock()
+					m.failClosed()
+					return
+				}
+				m.pending = &CumulativeReport{
+					SessionID: m.sessionID, Sequence: m.sequence + 1,
+					ClientToExitBytes: m.clientBytes, ExitToClientBytes: m.exitBytes,
+				}
+				m.lastReport = time.Now()
+			}
+		}
+		pending := m.pending
+		closing, activeCopy, closeBy := m.closing, m.activeCopy, m.closeBy
+		m.mu.Unlock()
+		if closing && !time.Now().Before(closeBy) {
+			return
+		}
+		if rateWait > 0 {
+			// Ignore write wakes until the next sequence is due. closeCh
+			// interrupts the throttle so a terminal snapshot can flush.
+			timer := time.NewTimer(rateWait)
+			select {
+			case <-timer.C:
+			case <-m.closeCh:
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			}
+			timer.Stop()
+			continue
+		}
+		if pending == nil {
+			if closing && activeCopy == 0 {
+				return
+			}
+			var deadline <-chan time.Time
+			var timer *time.Timer
+			if closing {
+				timer = time.NewTimer(time.Until(closeBy))
+				deadline = timer.C
+			}
+			select {
+			case <-m.updates:
+			case <-deadline:
+			case <-ctx.Done():
+				if timer != nil {
+					timer.Stop()
+				}
+				return
+			}
+			if timer != nil {
+				timer.Stop()
+			}
+			continue
+		}
+		if m.reporter == nil {
+			m.failClosed()
+			return
+		}
+		attemptDeadline := time.Now().Add(meterReportAttemptTimeout)
+		if closing && closeBy.Before(attemptDeadline) {
+			attemptDeadline = closeBy
+		}
+		attemptCtx, cancel := context.WithDeadline(ctx, attemptDeadline)
+		ack, err := m.reporter(attemptCtx, *pending)
+		cancel()
+		if err == nil && ack == *pending {
+			m.mu.Lock()
+			if m.pending == pending {
+				m.sequence = pending.Sequence
+				m.ackedClient = pending.ClientToExitBytes
+				m.ackedExit = pending.ExitToClientBytes
+				m.pending = nil
+			}
+			m.mu.Unlock()
+			retryDelay = meterReportRetryMin
+			continue
+		}
+		if err == nil { // An unknown or conflicting durable ack is not success.
+			m.failClosed()
+			return
+		}
+		m.mu.Lock()
+		closing, closeBy = m.closing, m.closeBy
+		m.mu.Unlock()
+		wait := retryDelay
+		if closing {
+			remaining := time.Until(closeBy)
+			if remaining <= 0 {
+				return
+			}
+			if wait > remaining {
+				wait = remaining
+			}
+		}
+		timer := time.NewTimer(wait)
+		var closingSignal <-chan struct{}
+		if !closing {
+			closingSignal = m.closeCh
+		}
+		select {
+		case <-timer.C:
+		case <-closingSignal:
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		}
+		timer.Stop()
+		if retryDelay < meterReportRetryMax {
+			retryDelay *= 2
+			if retryDelay > meterReportRetryMax {
+				retryDelay = meterReportRetryMax
+			}
+		}
+	}
+}
+
+func (m *sessionByteMeter) currentTotals() (int64, int64) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.clientBytes, m.exitBytes
+}
+
+func (s *Server) startMeterReporter(entry *managedLeaseEntry) {
+	if entry == nil || entry.byteMeter == nil {
+		return
+	}
+	s.goTracked(func() { entry.byteMeter.runReporter(context.Background()) })
+}
