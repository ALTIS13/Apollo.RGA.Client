+func TestManagedSessionRevocationClosesOnlyMatchingPeer(t *testing.T) {
+	firstSession, _, firstCleanup := smuxPair(t)
+	defer firstCleanup()
+	secondSession, _, secondCleanup := smuxPair(t)
+	defer secondCleanup()
+	first := &peerSession{peerID: "peer-first", sessionID: "sid-first", session: firstSession}
+	second := &peerSession{peerID: "peer-second", sessionID: "sid-second", session: secondSession}
+	s := &Server{
+		requireAuthHook: true,
+		peerSessions:    map[string]*peerSession{first.peerID: first, second.peerID: second},
+		onClose:         func(string, string) {},
+	}
+	if s.revokeManagedSession("") || s.revokeManagedSession("unknown") {
+		t.Fatal("empty or unknown session unexpectedly revoked a peer")
+	}
+	if !s.revokeManagedSession("sid-first") {
+		t.Fatal("matching session was not revoked")
+	}
+	if !firstSession.IsClosed() {
+		t.Fatal("revoked peer data session stayed open")
+	}
+	if secondSession.IsClosed() || s.peerSessions[second.peerID] != second {
+		t.Fatal("revoking first peer closed unrelated peer")
+	}
+	if s.revokeManagedSession("sid-first") {
+		t.Fatal("repeated revoke claimed to close the old session again")
+	}
+}
