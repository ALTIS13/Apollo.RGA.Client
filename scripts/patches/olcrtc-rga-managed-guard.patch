+func TestManagedByteBudgetConcurrentReservationsNeverExceedSharedLimit(t *testing.T) {
+	m := newSessionByteMeter(context.Background(), "meter-concurrent-session-001", 1000, echoMeterAck, func() {})
+	var total atomic.Int64
+	var workers sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		workers.Add(1)
+		go func(direction bool) {
+			defer workers.Done()
+			allowed, settle, err := m.Reserve(direction, 100)
+			if err != nil {
+				return
+			}
+			total.Add(int64(allowed))
+			settle(allowed)
+		}(i%2 == 0)
+	}
+	workers.Wait()
+	if got := total.Load(); got != 1000 {
+		t.Fatalf("shared budget reserved %d bytes, want exactly 1000", got)
+	}
+	up, down := m.currentTotals()
+	if up+down != 1000 {
+		t.Fatalf("committed %d bytes, want 1000", up+down)
+	}
+}
