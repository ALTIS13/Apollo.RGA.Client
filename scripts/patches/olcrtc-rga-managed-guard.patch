+	if err != nil {
+		t.Fatalf("AcceptStream() error = %v", err)
+	}
+	defer func() { _ = clientStream.Close(); _ = serverStream.Close() }()
+	remote, frozen := net.Pipe()
+	defer func() { _ = remote.Close(); _ = frozen.Close() }()
+	entered, release := make(chan struct{}), make(chan struct{})
+	s := &Server{
+		unsafeAllowPrivateTargets: true,
+		dialTarget: func(context.Context, string, string) (net.Conn, error) {
+			close(entered)
+			<-release // Deliberately ignores ctx, as an embedding dialer could.
+			return remote, nil
+		},
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		s.dispatch(ctx, serverStream, ConnectRequest{Cmd: testConnectCmd, Addr: "127.0.0.1", Port: 80}, "lease-session")
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("dialer was not reached")
+	}
+	cancel()
+	close(release)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("dispatch did not return after canceled dial")
+	}
+	_ = clientStream.SetReadDeadline(time.Now().Add(200 * time.Millisecond))
+	ack := make([]byte, 1)
+	if n, _ := clientStream.Read(ack); n > 0 && ack[0] == tunnelcore.ConnectAckOK {
+		t.Fatal("canceled managed dial sent CONNECT OK")
+	}
+}
