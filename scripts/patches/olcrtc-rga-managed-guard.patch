+func TestManagedLeaseRevokeBeforePublicationClosesEveryHandshakePath(t *testing.T) {
+	for _, path := range []string{"singleton", "peer-control", "data-only-peer"} {
+		t.Run(path, func(t *testing.T) {
+			const id = "lease-race-session-001"
+			serverSession, clientSession, gate, cleanup := managedGatedPair(t)
+			defer cleanup()
+			s := newHandshakeServer()
+			s.requireAuthHook = true
+			s.requireLease = true
+			s.meter = newMeter()
+			var opens atomic.Int32
+			s.onOpen = func(string, string, map[string]any) { opens.Add(1) }
+			s.liveness = control.Config{Interval: time.Hour, Timeout: time.Hour, Failures: 1}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer func() { cancel(); s.wg.Wait() }()
+			s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+				gate.enabled.Store(true)
+				return ManagedLease{SessionID: id, NotAfter: time.Now().Add(time.Minute)}, nil
+			}
+			controller := &SessionController{}
+			if !controller.attach(s) {
+				t.Fatal("could not attach controller")
+			}
+			defer controller.detach(s)
+			result := make(chan bool, 1)
+			switch path {
+			case "singleton":
+				s.session = serverSession
+				s.group = muxconn.PrePinned(newServerTestKeys(t), "lease-key")
+				go func() { result <- s.acceptSingletonHandshake(ctx, serverSession) }()
+			case "peer-control":
+				dataServer, _, dataCleanup := smuxPair(t)
+				defer dataCleanup()
+				peer := newPeerSession("lease-peer", true, muxconn.PrePinned(newServerTestKeys(t), "lease-key"))
+				peer.session, peer.controlSess = dataServer, serverSession
+				s.peerSessions = map[string]*peerSession{peer.peerID: peer}
+				go func() { s.acceptPeerHandshake(ctx, peer); result <- s.peerSessionActive(peer, id) }()
+			case "data-only-peer":
+				peer := newPeerSession("lease-peer", false, muxconn.PrePinned(newServerTestKeys(t), "lease-key"))
+				peer.session = serverSession
+				s.peerSessions = map[string]*peerSession{peer.peerID: peer}
+				s.baseCtx = ctx
+				go func() { result <- s.establishPeerSession(peer) }()
+			}
+			clientDone := make(chan struct{})
+			go func() {
+				defer close(clientDone)
+				stream, err := clientSession.OpenStream()
+				if err == nil {
+					_, _, _ = handshake.Client(stream, "device", nil)
+				}
+			}()
+			select {
+			case <-gate.blocked:
+			case <-result:
+				t.Fatal("handshake published before managed WELCOME write was released")
+			case <-time.After(2 * time.Second):
+				t.Fatal("managed WELCOME write did not reach gate")
+			}
+			if !controller.RevokeLease(id) {
+				t.Fatal("pending lease revoke was not recorded")
+			}
+			close(gate.release)
+			select {
+			case ready := <-result:
+				if ready {
+					t.Fatal("revoked lease became ready")
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("handshake did not finish after gate released")
+			}
+			if !serverSession.IsClosed() {
+				t.Fatal("revoked carrier remained open")
+			}
+			if opens.Load() != 0 {
+				t.Fatal("revoked lease reached OnSessionOpen")
+			}
+			<-clientDone
+		})
+	}
+}
