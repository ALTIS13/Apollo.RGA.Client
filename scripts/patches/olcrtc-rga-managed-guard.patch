diff --git a/internal/server/lease.go b/internal/server/lease.go
new file mode 100644
index 0000000..0cf9d90
--- /dev/null
+++ b/internal/server/lease.go
@@ -0,0 +1,223 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// ManagedLease is supplied only by a trusted embedding policy. A session ID
+// from the ordinary AuthHook or the local traffic meter is never a lease.
+type ManagedLease struct {
+	SessionID string
+	NotAfter  time.Time
+}
+
+type ManagedLeaseAuthFunc func(context.Context, string, map[string]any) (ManagedLease, error)
+
+var (
+	ErrLeaseHookRequired = errors.New("managed lease requires trusted hook")
+	errLeaseDenied       = errors.New("managed lease denied")
+)
+
+// This is a safety ceiling, not an operational lease lifetime. The latter
+// remains an external policy decision after real-system measurements.
+const maxManagedLeaseDuration = 5 * time.Minute
+const maxManagedLeaseRecords = 4096
+
+type managedLeaseState uint8
+
+const (
+	leasePending managedLeaseState = iota
+	leaseActive
+	leaseRevoked
+	leaseClosed
+)
+
+type managedLeaseEntry struct {
+	lease      ManagedLease
+	generation uint64
+	state      managedLeaseState
+	retainTo   time.Time
+	ctx        context.Context
+	cancel     context.CancelFunc
+}
+
+// leaseRegistry is process-local. A future Bridge adapter must enforce
+// one-time global session IDs across processes and restarts.
+type leaseRegistry struct {
+	mu         sync.Mutex
+	entries    map[string]*managedLeaseEntry
+	generation uint64
+	overflow   bool
+	limit      int // A zero value uses maxManagedLeaseRecords.
+}
+
+func (r *leaseRegistry) prepare(parent context.Context, lease ManagedLease) (*managedLeaseEntry, error) {
+	now := time.Now()
+	if !validLeaseID(lease.SessionID) || lease.NotAfter.IsZero() ||
+		!now.Before(lease.NotAfter) || lease.NotAfter.After(now.Add(maxManagedLeaseDuration)) {
+		return nil, errLeaseDenied
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.prune(now)
+	if r.overflow || r.entries[lease.SessionID] != nil || parent.Err() != nil ||
+		!time.Now().Before(lease.NotAfter) || !r.room() {
+		return nil, errLeaseDenied
+	}
+	r.generation++
+	leaseCtx, cancel := context.WithDeadline(parent, lease.NotAfter)
+	entry := &managedLeaseEntry{
+		lease: lease, generation: r.generation, state: leasePending,
+		retainTo: lease.NotAfter.Add(maxManagedLeaseDuration),
+		ctx:      leaseCtx, cancel: cancel,
+	}
+	r.entries[lease.SessionID] = entry
+	return entry, nil
+}
+
+func (r *leaseRegistry) revoke(id string) bool {
+	if !validLeaseID(id) {
+		return false
+	}
+	now := time.Now()
+	r.mu.Lock()
+	r.prune(now)
+	if entry := r.entries[id]; entry != nil {
+		entry.state = leaseRevoked
+		cancel := entry.cancel
+		r.mu.Unlock()
+		if cancel != nil {
+			cancel()
+		}
+		return true
+	}
+	if r.overflow || !r.room() {
+		r.mu.Unlock()
+		return false
+	}
+	r.generation++
+	r.entries[id] = &managedLeaseEntry{
+		lease: ManagedLease{SessionID: id}, generation: r.generation,
+		state: leaseRevoked, retainTo: now.Add(maxManagedLeaseDuration + 2*handshakeTimeout),
+	}
+	r.mu.Unlock()
+	return true
+}
+
+const handshakeTimeout = 15 * time.Second
+
+func (r *leaseRegistry) abort(entry *managedLeaseEntry) {
+	if entry == nil {
+		return
+	}
+	r.mu.Lock()
+	if r.entries[entry.lease.SessionID] == entry && entry.state == leasePending {
+		entry.state = leaseClosed
+	}
+	r.mu.Unlock()
+	if entry.cancel != nil {
+		entry.cancel()
+	}
+}
+
+// activate is called only after the ID is published under the session lock.
+// It deliberately takes no session lock: a concurrent revoke leaves a
+// tombstone which forces the caller to cut off its just-published generation.
+func (r *leaseRegistry) activate(entry *managedLeaseEntry) bool {
+	if entry == nil {
+		return true // Legacy handshake.
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.entries[entry.lease.SessionID] != entry || entry.state != leasePending ||
+		!time.Now().Before(entry.lease.NotAfter) || entry.ctx.Err() != nil {
+		return false
+	}
+	entry.state = leaseActive
+	return true
+}
+
+func (r *leaseRegistry) finish(entry *managedLeaseEntry) {
+	if entry == nil {
+		return
+	}
+	r.mu.Lock()
+	if r.entries[entry.lease.SessionID] == entry && entry.state != leaseRevoked {
+		entry.state = leaseClosed
+	}
+	r.mu.Unlock()
+	if entry.cancel != nil {
+		entry.cancel()
+	}
+}
+
+func (r *leaseRegistry) expire(entry *managedLeaseEntry) bool {
+	if entry == nil || !errors.Is(entry.ctx.Err(), context.DeadlineExceeded) {
+		return false
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.entries[entry.lease.SessionID] != entry || entry.state != leaseActive {
+		return false
+	}
+	entry.state = leaseClosed
+	return true
+}
+
+func (s *Server) watchLease(entry *managedLeaseEntry) {
+	if entry == nil {
+		return
+	}
+	context.AfterFunc(entry.ctx, func() {
+		if !errors.Is(entry.ctx.Err(), context.DeadlineExceeded) {
+			return
+		}
+		s.goTracked(func() {
+			if s.leases.expire(entry) {
+				s.cutoffLease(entry, "expired")
+			}
+		})
+	})
+}
+
+func (r *leaseRegistry) room() bool {
+	if r.entries == nil {
+		r.entries = make(map[string]*managedLeaseEntry)
+	}
+	limit := r.limit
+	if limit <= 0 {
+		limit = maxManagedLeaseRecords
+	}
+	if len(r.entries) >= limit {
+		// A failed revoke might have been omitted; never resume admissions
+		// after pruning without an external reconciliation of that ID.
+		r.overflow = true
+		return false
+	}
+	return true
+}
+
+func (r *leaseRegistry) prune(now time.Time) {
+	for id, entry := range r.entries {
+		if entry.state != leasePending && entry.state != leaseActive && !now.Before(entry.retainTo) {
+			delete(r.entries, id)
+		}
+	}
+}
+
+func validLeaseID(id string) bool {
+	if len(id) < 16 || len(id) > 128 {
+		return false
+	}
+	for i := 0; i < len(id); i++ {
+		c := id[i]
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-' {
+			continue
+		}
+		return false
+	}
+	return true
+}
