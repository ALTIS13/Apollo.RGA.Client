+func TestManagedLeaseDeadlineCutsFrozenTCPWithoutRefresh(t *testing.T) {
+	serverSession, clientSession, cleanup := smuxPair(t)
+	defer cleanup()
+	ctx, cancel := context.WithCancel(context.Background())
+	s := newHandshakeServer()
+	defer func() { cancel(); s.wg.Wait() }()
+	s.requireAuthHook = true
+	s.requireLease = true
+	s.session = serverSession
+	s.group = muxconn.PrePinned(newServerTestKeys(t), "lease-key")
+	s.meter = newMeter()
+	s.unsafeAllowPrivateTargets = true
+	s.liveness = control.Config{Interval: time.Hour, Timeout: time.Hour, Failures: 1}
+	s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+		return ManagedLease{SessionID: "frozen-tcp-lease-001", NotAfter: time.Now().Add(700 * time.Millisecond)}, nil
+	}
+	remote, frozen := net.Pipe()
+	defer func() { _ = frozen.Close(); _ = remote.Close() }()
+	s.dialTarget = func(context.Context, string, string) (net.Conn, error) { return remote, nil }
+	clientHandshake := make(chan error, 1)
+	go func() {
+		stream, err := clientSession.OpenStream()
+		if err == nil {
+			_, _, err = handshake.Client(stream, "device", nil)
+		}
+		clientHandshake <- err
+	}()
+	if !s.acceptSingletonHandshake(ctx, serverSession) {
+		t.Fatal("managed handshake failed")
+	}
+	if err := <-clientHandshake; err != nil {
+		t.Fatalf("client handshake failed: %v", err)
+	}
+	handlerDone := make(chan struct{})
+	go func() {
+		defer close(handlerDone)
+		stream, err := serverSession.AcceptStream()
+		if err == nil {
+			s.handleStream(context.Background(), stream, "frozen-tcp-lease-001")
+		}
+	}()
+	stream, err := clientSession.OpenStream()
+	if err != nil {
+		t.Fatalf("OpenStream() error = %v", err)
+	}
+	req, err := json.Marshal(ConnectRequest{Cmd: testConnectCmd, Addr: "127.0.0.1", Port: 80})
+	if err != nil {
+		t.Fatalf("Marshal() error = %v", err)
+	}
+	if _, err := stream.Write(req); err != nil {
+		t.Fatalf("CONNECT write failed: %v", err)
+	}
+	_ = stream.SetReadDeadline(time.Now().Add(2 * time.Second))
+	ack := make([]byte, 1)
+	if _, err := io.ReadFull(stream, ack); err != nil || ack[0] != tunnelcore.ConnectAckOK {
+		t.Fatalf("frozen TCP was not open before deadline: ack=%v err=%v", ack, err)
+	}
+	if _, err := stream.Read(make([]byte, 1)); err == nil {
+		t.Fatal("frozen TCP still open after deadline")
+	}
+	select {
+	case <-handlerDone:
+	case <-time.After(time.Second):
+		t.Fatal("server egress copy did not stop after deadline")
+	}
+	if !serverSession.IsClosed() {
+		t.Fatal("managed carrier remained open after deadline")
+	}
+}
