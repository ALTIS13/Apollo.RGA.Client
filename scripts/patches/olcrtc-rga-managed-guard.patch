+func TestManagedMeterReportsBeforeEOFAndRetriesImmutableSnapshot(t *testing.T) {
+	calls := make(chan CumulativeReport, 4)
+	releaseFirst := make(chan struct{})
+	var attempts atomic.Int32
+	reporter := func(_ context.Context, report CumulativeReport) (CumulativeReport, error) {
+		calls <- report
+		if attempts.Add(1) == 1 {
+			<-releaseFirst
+			return CumulativeReport{}, errors.New("ambiguous commit")
+		}
+		return report, nil
+	}
+	m := newSessionByteMeter(context.Background(), "meter-report-session-001", 10, reporter, func() {})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { m.runReporter(ctx); close(done) }()
+	allowed, settle, err := m.Reserve(true, 2)
+	if err != nil || allowed != 2 {
+		t.Fatalf("first Reserve() = %d, %v", allowed, err)
+	}
+	settle(2)
+	first := receiveMeterReport(t, calls)
+	if first != (CumulativeReport{"meter-report-session-001", 1, 2, 0}) {
+		t.Fatalf("first report = %+v, want seq 1 and 2/0 before EOF", first)
+	}
+	allowed, settle, err = m.Reserve(false, 1)
+	if err != nil || allowed != 1 {
+		t.Fatalf("second Reserve() = %d, %v", allowed, err)
+	}
+	settle(1)
+	select {
+	case extra := <-calls:
+		t.Fatalf("reporter had concurrent in-flight call: %+v", extra)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(releaseFirst)
+	if retry := receiveMeterReport(t, calls); retry != first {
+		t.Fatalf("ambiguous ack changed snapshot: retry=%+v first=%+v", retry, first)
+	}
+	if next := receiveMeterReport(t, calls); next != (CumulativeReport{"meter-report-session-001", 2, 2, 1}) {
+		t.Fatalf("post-ack cumulative report = %+v, want seq 2 and 2/1", next)
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("reporter worker did not stop")
+	}
+}
