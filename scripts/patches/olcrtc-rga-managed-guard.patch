+	s.group = muxconn.PrePinned(newServerTestKeys(t), "meter-key")
+	s.meter = newMeter()
+	s.unsafeAllowPrivateTargets = true
+	s.liveness = control.Config{Interval: time.Hour, Timeout: time.Hour, Failures: 1}
+	s.leaseAuthHook = func(context.Context, string, map[string]any) (ManagedLease, error) {
+		return ManagedLease{SessionID: "meter-live-tcp-session-001", NotAfter: time.Now().Add(time.Minute), ByteLimit: 20}, nil
+	}
+	reports := make(chan CumulativeReport, 4)
+	s.meterReporter = func(_ context.Context, report CumulativeReport) (CumulativeReport, error) {
+		reports <- report
+		return report, nil
+	}
+	var finalTraffic atomic.Int32
+	s.onTraffic = func(string, string, uint64, uint64) { finalTraffic.Add(1) }
+	remote, frozen := net.Pipe()
+	defer func() { _ = remote.Close(); _ = frozen.Close() }()
+	s.dialTarget = func(context.Context, string, string) (net.Conn, error) { return remote, nil }
+	ctx, cancel := context.WithCancel(context.Background())
+	serveDone := make(chan struct{})
+	go func() { s.serveSingle(ctx); close(serveDone) }()
+	defer func() {
+		cancel()
+		s.closeSession()
+		<-serveDone
+		s.wg.Wait()
+	}()
+	controlStream, err := clientSession.OpenStream()
+	if err != nil {
+		t.Fatalf("control OpenStream() error = %v", err)
+	}
+	if _, _, err := handshake.Client(controlStream, "device", nil); err != nil {
+		t.Fatalf("client handshake error = %v", err)
+	}
+	dataStream, err := clientSession.OpenStream()
+	if err != nil {
+		t.Fatalf("data OpenStream() error = %v", err)
+	}
+	request, err := json.Marshal(ConnectRequest{Cmd: testConnectCmd, Addr: "127.0.0.1", Port: 80})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := dataStream.Write(request); err != nil {
+		t.Fatalf("CONNECT write failed: %v", err)
+	}
+	_ = dataStream.SetReadDeadline(time.Now().Add(time.Second))
+	ack := make([]byte, 1)
+	if _, err := io.ReadFull(dataStream, ack); err != nil || ack[0] != tunnelcore.ConnectAckOK {
+		t.Fatalf("CONNECT ack = %v, %v, want OK", ack, err)
+	}
+	if _, err := dataStream.Write([]byte("abc")); err != nil {
+		t.Fatalf("client payload write failed: %v", err)
+	}
+	_ = frozen.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := io.ReadFull(frozen, make([]byte, 3)); err != nil {
+		t.Fatalf("exit did not receive client bytes: %v", err)
+	}
+	if report := receiveMeterReport(t, reports); report != (CumulativeReport{"meter-live-tcp-session-001", 1, 3, 0}) {
+		t.Fatalf("pre-EOF client report = %+v", report)
+	}
+	if _, err := frozen.Write([]byte("XY")); err != nil {
+		t.Fatalf("exit payload write failed: %v", err)
+	}
+	if _, err := io.ReadFull(dataStream, make([]byte, 2)); err != nil {
+		t.Fatalf("client did not receive exit bytes: %v", err)
+	}
+	if report := receiveMeterReport(t, reports); report != (CumulativeReport{"meter-live-tcp-session-001", 2, 3, 2}) {
+		t.Fatalf("pre-EOF bidirectional report = %+v", report)
+	}
+	_ = dataStream.Close()
+	_ = frozen.Close()
+	cancel()
+	s.closeSession()
+	<-serveDone
+	s.wg.Wait()
+	if finalTraffic.Load() != 0 {
+		t.Fatal("managed stream invoked final OnTraffic and could be double-counted")
+	}
+}
