+func TestManagedStaleSingletonHandshakeCannotAuthorizeReplacement(t *testing.T) {
+	oldServer, oldClient, oldCleanup := smuxPair(t)
+	defer oldCleanup()
+	newServer, _, newCleanup := smuxPair(t)
+	defer newCleanup()
+	s := newHandshakeServer()
+	s.requireAuthHook = true
+	s.session = oldServer
+	s.group = muxconn.PrePinned(newServerTestKeys(t), "managed-single")
+	s.meter = newMeter()
+	authEntered := make(chan struct{})
+	releaseAuth := make(chan struct{})
+	s.authHook = func(string, map[string]any) (string, error) {
+		close(authEntered)
+		<-releaseAuth
+		return "old-session-id", nil
+	}
+	clientDone := make(chan struct{})
+	go func() {
+		defer close(clientDone)
+		stream, err := oldClient.OpenStream()
+		if err == nil {
+			_, _, _ = handshake.Client(stream, "device", nil)
+		}
+	}()
+	result := make(chan bool, 1)
+	go func() { result <- s.acceptSingletonHandshake(context.Background(), oldServer) }()
+	<-authEntered
+	s.sessMu.Lock()
+	s.session = newServer
+	s.sessMu.Unlock()
+	close(releaseAuth)
+	if <-result {
+		t.Fatal("stale handshake was accepted after carrier replacement")
+	}
+	if s.handshakeReady() || meteredKey(s.meter, "old-session-id") != "" {
+		t.Fatal("stale handshake authorized the replacement carrier")
+	}
+	<-clientDone
+}
