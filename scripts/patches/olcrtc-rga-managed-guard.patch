+func TestManagedSingletonRevokeInstallsFreshCarrierSession(t *testing.T) {
+	keys := newServerTestKeys(t)
+	link := &serverLinkStub{}
+	conn := muxconn.New(link, keys)
+	oldSession, err := smux.Server(conn, testSmuxCfg())
+	if err != nil {
+		t.Fatalf("smux.Server() error = %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	s := &Server{
+		baseCtx: ctx, ln: link, ring: cryptopkg.SingleEntry(keys, ""),
+		conn: conn, session: oldSession, sessionID: "old", requireAuthHook: true,
+		onClose: func(string, string) {}, peerSessions: make(map[string]*peerSession),
+		done: make(chan struct{}),
+	}
+	defer func() {
+		cancel()
+		s.shutdown()
+		s.wg.Wait()
+	}()
+	if !s.revokeManagedSession("old") {
+		t.Fatal("old session was not revoked")
+	}
+	s.wg.Wait()
+	s.sessMu.RLock()
+	replacement := s.session
+	s.sessMu.RUnlock()
+	if replacement == nil || replacement == oldSession || replacement.IsClosed() {
+		t.Fatal("revocation left the carrier without a usable replacement session")
+	}
+}
