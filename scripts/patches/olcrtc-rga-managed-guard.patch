+func managedGatedPair(t *testing.T) (*smux.Session, *smux.Session, *gatedWriteConn, func()) {
+	t.Helper()
+	a, b := net.Pipe()
+	gate := &gatedWriteConn{Conn: a, release: make(chan struct{}), blocked: make(chan struct{})}
+	serverSession, err := smux.Server(gate, testSmuxCfg())
+	if err != nil {
+		t.Fatalf("smux.Server() error = %v", err)
+	}
+	clientSession, err := smux.Client(b, testSmuxCfg())
+	if err != nil {
+		t.Fatalf("smux.Client() error = %v", err)
+	}
+	return serverSession, clientSession, gate, func() {
+		select {
+		case <-gate.release:
+		default:
+			close(gate.release)
+		}
+		_ = serverSession.Close()
+		_ = clientSession.Close()
+		_ = a.Close()
+		_ = b.Close()
+	}
+}
