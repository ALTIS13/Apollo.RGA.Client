+	s := newHandshakeServer()
+	s.requireAuthHook = true
+	s.session = serverSess
+	s.group = muxconn.PrePinned(newServerTestKeys(t), "managed-single")
+	s.meter = newMeter()
+	controller := &SessionController{}
+	if !controller.attach(s) {
+		t.Fatal("could not bind controller")
+	}
+	defer controller.detach(s)
+	var revoked bool
+	s.onOpen = func(id, _ string, _ map[string]any) {
+		revoked = controller.CloseSession(id)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer func() { cancel(); s.wg.Wait() }()
+	go func() {
+		stream, err := clientSess.OpenStream()
+		if err == nil {
+			_, _, _ = handshake.Client(stream, "device", nil)
+		}
+	}()
+	if s.acceptSingletonHandshake(ctx, serverSess) {
+		t.Fatal("revoked singleton handshake became data-ready")
+	}
+	if !revoked || !serverSess.IsClosed() || s.handshakeReady() {
+		t.Fatalf("revoked=%v closed=%v ready=%v, want true/true/false",
+			revoked, serverSess.IsClosed(), s.handshakeReady())
+	}
+}
