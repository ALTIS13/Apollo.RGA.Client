+	live := &peerSession{peerID: old.peerID, sessionID: "sid-new", session: liveSession}
+	s := &Server{requireAuthHook: true, peerSessions: map[string]*peerSession{live.peerID: live}}
+	if s.revokeManagedSession(old.sessionID) {
