+func TestManagedServerLifecycleLogsDoNotExposeClientIdentifiers(t *testing.T) {
+	var buf bytes.Buffer
+	oldWriter, oldFlags := log.Writer(), log.Flags()
+	log.SetOutput(&buf)
+	log.SetFlags(0)
+	t.Cleanup(func() {
+		log.SetOutput(oldWriter)
+		log.SetFlags(oldFlags)
+	})
+	s := &Server{requireAuthHook: true, peerStats: make(map[string]peerStat)}
+	s.logSessionOpened("secret-session", "secret-device", "secret-peer")
+	s.trackPeerOpen("secret-session", "secret-device")
+	s.logPeersLine()
+	s.trackPeerClose("secret-session", "closed")
+	got := buf.String()
+	for _, secret := range []string{"secret-session", "secret-device", "secret-peer"} {
+		if strings.Contains(got, secret) {
+			t.Fatalf("managed lifecycle log exposed client identifier: %q", got)
+		}
+	}
+	if !strings.Contains(got, "Current peers count: 1") {
+		t.Fatalf("managed lifecycle log lost useful peer count: %q", got)
+	}
+}
