+func TestManagedLeaseCancelledDuringUncooperativeDialNeverAcknowledgesConnect(t *testing.T) {
+	serverSession, clientSession, cleanup := smuxPair(t)
+	defer cleanup()
+	clientStream, err := clientSession.OpenStream()
+	if err != nil {
