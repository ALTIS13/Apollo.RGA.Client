+func TestManagedSessionConcurrentRevokeClosesOnce(t *testing.T) {
+	dataSession, _, cleanup := smuxPair(t)
+	defer cleanup()
+	peer := &peerSession{peerID: "one-peer", sessionID: "one-session", session: dataSession}
+	var closes, successes atomic.Int32
+	s := &Server{
+		requireAuthHook: true,
+		peerSessions:    map[string]*peerSession{peer.peerID: peer},
+		onClose:         func(string, string) { closes.Add(1) },
+	}
+	controller := &SessionController{}
+	if !controller.attach(s) {
+		t.Fatal("could not bind controller")
+	}
+	defer controller.detach(s)
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if controller.CloseSession("one-session") {
+				successes.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	if successes.Load() != 1 || closes.Load() != 1 || !dataSession.IsClosed() {
+		t.Fatalf("revoke successes=%d closes=%d dataClosed=%v, want 1/1/true",
+			successes.Load(), closes.Load(), dataSession.IsClosed())
+	}
+}
