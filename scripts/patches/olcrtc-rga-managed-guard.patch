+func TestSessionControllerOnlyTargetsBoundManagedRun(t *testing.T) {
+	controller := &SessionController{}
+	if controller.CloseSession("sid") {
+		t.Fatal("unbound controller revoked a session")
+	}
+	dataSession, _, cleanup := smuxPair(t)
+	defer cleanup()
+	managed := &Server{
+		requireAuthHook: true, sessionID: "sid", session: dataSession,
+		onClose: func(string, string) {},
+	}
+	if !controller.attach(managed) || controller.attach(&Server{}) {
+		t.Fatal("controller accepted no run or a concurrent second run")
+	}
+	if !controller.CloseSession("sid") || !dataSession.IsClosed() {
+		t.Fatal("bound managed session was not revoked")
+	}
+	controller.detach(&Server{})
+	if controller.attach(&Server{}) {
+		t.Fatal("stale detach removed the active run")
+	}
+	controller.detach(managed)
+	if controller.CloseSession("sid") {
+		t.Fatal("controller retained a stopped run")
+	}
+	legacySession, _, legacyCleanup := smuxPair(t)
+	defer legacyCleanup()
+	legacy := &Server{sessionID: "legacy", session: legacySession}
+	if !controller.attach(legacy) {
+		t.Fatal("controller did not bind a later run")
+	}
+	if controller.CloseSession("legacy") || legacySession.IsClosed() {
+		t.Fatal("controller revoked a non-managed session")
+	}
+	controller.detach(legacy)
+}
