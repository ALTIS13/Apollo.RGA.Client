+func TestCopyBidirectionalWithPermitUsesBothDirections(t *testing.T) {
+	left := &memoryConn{reader: bytes.NewReader([]byte("abc"))}
+	right := &memoryConn{reader: bytes.NewReader([]byte("WXYZ"))}
+	type write struct {
+		leftToRight bool
+		requested   int
+		settled     int
+	}
+	writes := make(chan write, 2)
+	permit := permitFunc(func(leftToRight bool, requested int) (int, func(int), error) {
+		return requested, func(n int) {
+			writes <- write{leftToRight: leftToRight, requested: requested, settled: n}
+		}, nil
+	})
+
+	counts, err := CopyBidirectionalWithPermit(context.Background(), left, right, permit)
+	if err != nil {
+		t.Fatalf("copy error = %v", err)
+	}
+	if counts != (CopyCounts{LeftToRight: 3, RightToLeft: 4}) ||
+		left.writer.String() != "WXYZ" || right.writer.String() != "abc" {
+		t.Fatalf("copy counts=%+v left=%q right=%q", counts, left.writer.String(), right.writer.String())
+	}
+	got := map[bool]write{}
+	for range 2 {
+		entry := <-writes
+		got[entry.leftToRight] = entry
+	}
+	if got[true] != (write{leftToRight: true, requested: 3, settled: 3}) ||
+		got[false] != (write{leftToRight: false, requested: 4, settled: 4}) || len(writes) != 0 {
+		t.Fatalf("directional reservations = %+v", got)
